{
  "name": "Commodore 128 BASIC 7.0",
  "version": "7.0",
  "author": "Commodore Business Machines",
  "description": "BASIC 7.0 as found in the Commodore 128. Extends BASIC V2 with structured flow control (DO/LOOP/EXIT), disk commands, sprite control, music, hi-res graphics, and more. Uses two prefix bytes: $CE for function tokens and $FE for command tokens.",
  "url": "https://www.c64-wiki.com/wiki/BASIC_7.0",
  "extendsBasicV2": true,
  "loadAddress": 7169,
  "tokenPrefixes": [
    {
      "byte": 206,
      "description": "CE-prefix: BASIC 7.0 extended functions"
    },
    {
      "byte": 254,
      "description": "FE-prefix: BASIC 7.0 extended commands"
    }
  ],
  "keywords": [
    {
      "keyword": "RGR",
      "token": 204,
      "type": "function",
      "category": "graphics",
      "syntax": "RGR(n)",
      "description": "Read graphics register n"
    },
    {
      "keyword": "RCLR",
      "token": 205,
      "type": "function",
      "category": "graphics",
      "syntax": "RCLR(n)",
      "description": "Read color register n"
    },
    {
      "keyword": "JOY",
      "token": 207,
      "type": "function",
      "category": "io",
      "syntax": "JOY(n)",
      "description": "Read joystick port n (1 or 2)",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "1-2"
        }
      ],
      "example": "IF JOY(1) AND 16 THEN PRINT \"FIRE!\""
    },
    {
      "keyword": "RDOT",
      "token": 208,
      "type": "function",
      "category": "graphics",
      "syntax": "RDOT(x, y)",
      "description": "Read the pixel value at graphics position x,y"
    },
    {
