{
  "name": "Commander X16 BASIC",
  "version": "R49",
  "author": "Commander X16 Community",
  "description": "BASIC V2 extensions for the Commander X16. All token values verified against the R49 ROM binary dispatch tables. Single-byte tokens ($CC-$F7) for the main command set; $CE-prefixed two-byte tokens for later commands (CE $AC-$B7) and all expression functions (CE $C2-$D0).",
  "url": "https://commanderx16.com",
  "extendsBasicV2": true,
  "loadAddress": 2049,
  "tokenPrefixes": [
    {
      "byte": 206,
      "description": "$CE prefix for late commands (REBOOT-BANNER) and all expression functions (VPEEK-MOD)"
    }
  ],
  "keywords": [
    {
      "keyword": "MON",
      "token": 204,
      "type": "command",
      "category": "system",
      "syntax": "MON",
      "description": "Enter the machine code monitor"
    },
    {
      "keyword": "DOS",
      "token": 205,
      "type": "command",
      "category": "io",
      "syntax": "DOS [command$]",
      "description": "Send a DOS command or display disk status",
      "example": "DOS\"$\""
    },
    {
      "keyword": "OLD",
      "token": 206,
      "type": "command",
      "category": "system",
      "syntax": "OLD",
      "description": "Recover a program deleted with NEW"
    },
    {
      "keyword": "GEOS",
      "token": 207,
      "type": "command",
      "category": "system",
      "syntax": "GEOS",
      "description": "Launch the GEOS graphical environment"
    },
    {
      "keyword": "VPOKE",
      "token": 208,
      "type": "command",
      "category": "graphics",
      "syntax": "VPOKE bank, address, value",
      "description": "Write a byte to VERA video RAM",
      "parameters": [
        {
          "name": "bank",
          "type": "integer",
          "range": "0-1"
        },
        {
          "name": "address",
          "type": "integer",
          "range": "0-65535"
        },
        {
          "name": "value",
          "type": "integer",
          "range": "0-255"
        }
      ],
      "example": "VPOKE 0,0,65"
    },
    {
      "keyword": "VLOAD",
      "token": 209,
      "type": "command",
      "category": "io",
      "syntax": "VLOAD \"filename\", device, bank, address",
      "description": "Load a file directly into VERA video RAM",
      "example": "VLOAD \"SPRITES.BIN\",8,0,0"
    },
    {
      "keyword": "SCREEN",
      "token": 210,
      "type": "command",
      "category": "graphics",
      "syntax": "SCREEN mode",
      "description": "Set screen display mode. 0=40x30 text, 2=80x60 text, 128=320x240 bitmap",
      "example": "SCREEN 128"
    },
    {
      "keyword": "PSET",
      "token": 211,
      "type": "command",
      "category": "graphics",
      "syntax": "PSET x, y, color",
      "description": "Plot a pixel at x,y with palette color index",
      "example": "PSET 160,120,7"
    },
    {
      "keyword": "LINE",
      "token": 212,
      "type": "command",
      "category": "graphics",
      "syntax": "LINE x1, y1, x2, y2, color",
      "description": "Draw a line between two points",
      "example": "LINE 0,0,319,239,7"
    },
    {
      "keyword": "FRAME",
      "token": 213,
      "type": "command",
      "category": "graphics",
      "syntax": "FRAME x1, y1, x2, y2, color",
      "description": "Draw a rectangle outline",
      "example": "FRAME 10,10,100,80,7"
    },
    {
      "keyword": "RECT",
      "token": 214,
      "type": "command",
      "category": "graphics",
      "syntax": "RECT x1, y1, x2, y2, color",
      "description": "Draw a filled rectangle",
      "example": "RECT 10,10,100,80,3"
    },
    {
      "keyword": "CHAR",
      "token": 215,
      "type": "command",
      "category": "screen",
      "syntax": "CHAR x, y, color, string$",
      "description": "Print a string at character-cell position x,y with given color",
      "example": "CHAR 10,5,7,\"HELLO X16\""
    },
    {
      "keyword": "MOUSE",
      "token": 216,
      "type": "command",
      "category": "io",
      "syntax": "MOUSE mode",
      "description": "Enable/disable mouse cursor. 0=off, 1=on",
      "example": "MOUSE 1"
    },
    {
      "keyword": "COLOR",
      "token": 217,
      "type": "command",
      "category": "screen",
      "syntax": "COLOR foreground [,background]",
      "description": "Set text foreground and background colors (0-15)",
      "example": "COLOR 7,0"
    },
    {
      "keyword": "TEST",
      "token": 218,
      "type": "command",
      "category": "system",
