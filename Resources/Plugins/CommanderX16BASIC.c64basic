        {
          "name": "ram_bank",
          "type": "integer",
          "range": "0-255"
        },
        {
          "name": "rom_bank",
          "type": "integer",
          "range": "0-31"
        }
      ],
      "example": "BANK 1,0"
    },
    {
      "keyword": "FMINIT",
