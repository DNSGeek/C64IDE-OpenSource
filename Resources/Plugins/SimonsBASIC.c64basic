{
  "name": "Simons' BASIC",
  "version": "1.0",
  "author": "David Simons / Commodore",
  "description": "Simons' BASIC for the Commodore 64. Adds 116 keywords covering structured programming (PROC/CALL, REPEAT/UNTIL, LOOP/END LOOP, ON ERROR), hi-res graphics (HIRES, PLOT, LINE, CIRCLE, ARC, FILL, PAINT), sprites/MOBs (MOB SET, MMOB, CMOB, DETECT), SID sound (SOUND, PLAY, ENVELOPE, WAVE, VOL), string handling (INST, INSERT, LIN, INKEY), and disk/utility operations. All keywords use the $64 prefix byte. IMPORTANT: When using Simons' BASIC keywords after IF/THEN, a colon is required between THEN and the keyword. Write 'IF cond THEN:KEYWORD' not 'IF cond THEN KEYWORD' — the standard BASIC THEN dispatcher bypasses the Simons' extension handler.",
  "url": "https://www.c64-wiki.com/wiki/Simons%27_BASIC",
  "extendsBasicV2": true,
  "loadAddress": 2049,
  "activationSYS": 64738,
  "tokenPrefixes": [
    {
      "byte": 100,
      "description": "Simons' BASIC prefix ($64) — all Simons' BASIC keywords use this prefix followed by a token byte $01-$7F"
    }
  ],
  "keywords": [
    {
      "keyword": "HIRES",
      "prefix": 100,
      "token": 1,
      "type": "command",
      "category": "graphics",
      "syntax": "HIRES mode, color",
      "description": "Switch to hi-resolution bitmap mode (320x200 pixels). Mode 0 returns to text; mode 1 enables hi-res. Color sets the background color for the bitmap screen.",
      "parameters": [
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=return to text mode, 1=enter hi-res mode"
        },
        {
          "name": "color",
          "type": "integer",
          "range": "0-15",
          "description": "Background color index for the hi-res screen"
        }
      ],
      "example": "HIRES 1, 0 : REM HI-RES, BLACK BACKGROUND\nPLOT 160, 100, 1\nHIRES 0, 0 : REM RETURN TO TEXT"
    },
    {
      "keyword": "PLOT",
      "prefix": 100,
      "token": 2,
      "type": "command",
      "category": "graphics",
      "syntax": "PLOT x, y, mode",
      "description": "Set or clear a single pixel in hi-res mode at position x,y.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-319",
          "description": "Horizontal pixel position"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-199",
          "description": "Vertical pixel position"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=erase pixel, 1=set pixel"
        }
      ],
      "example": "HIRES 1, 0\nPLOT 160, 100, 1 : REM SET CENTER PIXEL\nPLOT 160, 100, 0 : REM CLEAR IT"
    },
    {
      "keyword": "LINE",
      "prefix": 100,
      "token": 3,
      "type": "command",
      "category": "graphics",
      "syntax": "LINE x1, y1, x2, y2, mode",
      "description": "Draw a straight line between two pixel coordinates in hi-res mode.",
      "parameters": [
        {
          "name": "x1",
          "type": "integer",
          "range": "0-319",
          "description": "Starting X coordinate"
        },
        {
          "name": "y1",
          "type": "integer",
          "range": "0-199",
          "description": "Starting Y coordinate"
        },
        {
          "name": "x2",
          "type": "integer",
          "range": "0-319",
          "description": "Ending X coordinate"
        },
        {
          "name": "y2",
          "type": "integer",
          "range": "0-199",
          "description": "Ending Y coordinate"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-2",
          "description": "0=erase, 1=draw, 2=XOR"
        }
      ],
      "example": "HIRES 1, 0\nLINE 0, 0, 319, 199, 1 : REM DIAGONAL"
    },
    {
      "keyword": "BLOCK",
      "prefix": 100,
      "token": 4,
      "type": "command",
      "category": "graphics",
      "syntax": "BLOCK x1, y1, x2, y2, mode",
      "description": "Draw a filled rectangle (block) in hi-res mode between the two corner coordinates.",
      "parameters": [
        {
          "name": "x1",
          "type": "integer",
          "range": "0-319",
          "description": "Left X coordinate"
        },
        {
          "name": "y1",
          "type": "integer",
          "range": "0-199",
          "description": "Top Y coordinate"
        },
        {
          "name": "x2",
          "type": "integer",
          "range": "0-319",
          "description": "Right X coordinate"
        },
        {
          "name": "y2",
          "type": "integer",
          "range": "0-199",
          "description": "Bottom Y coordinate"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-2",
          "description": "0=erase, 1=fill, 2=XOR"
        }
      ],
      "example": "HIRES 1, 0\nBLOCK 10, 10, 100, 100, 1 : REM FILLED BLOCK"
    },
    {
      "keyword": "FCHR",
      "prefix": 100,
      "token": 5,
      "type": "command",
      "category": "graphics",
      "syntax": "FCHR x, y, char, color",
      "description": "Print a single character at hi-res screen position (x, y) using the specified color.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-39",
          "description": "Text column (0-39 in 40-column mode)"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-24",
          "description": "Text row"
        },
        {
          "name": "char",
          "type": "integer",
          "range": "0-255",
          "description": "Character code (PETSCII)"
        },
        {
          "name": "color",
          "type": "integer",
          "range": "0-15",
          "description": "Character color"
        }
      ],
      "example": "HIRES 1, 0\nFCHR 10, 5, 65, 1 : REM 'A' IN WHITE AT COL 10, ROW 5"
    },
    {
      "keyword": "FCOL",
      "prefix": 100,
      "token": 6,
      "type": "command",
      "category": "graphics",
      "syntax": "FCOL color",
      "description": "Set the foreground drawing color for hi-res graphics operations.",
      "parameters": [
        {
          "name": "color",
          "type": "integer",
          "range": "0-15",
          "description": "Foreground color index"
        }
      ],
      "example": "HIRES 1, 0\nFCOL 7 : REM YELLOW\nLINE 0, 0, 319, 199, 1"
    },
    {
      "keyword": "FILL",
      "prefix": 100,
      "token": 7,
      "type": "command",
      "category": "graphics",
      "syntax": "FILL x, y, mode",
      "description": "Flood fill an enclosed area in hi-res mode outward from the seed point (x, y). Fill spreads to all adjacent pixels matching the seed pixel state and stops at pixels with a different state. FILL fills the interior of a boundary. See also PAINT which fills from a boundary edge inward.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-319",
          "description": "Seed X coordinate — fill starts here"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-199",
          "description": "Seed Y coordinate"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=fill with background, 1=fill with foreground"
        }
      ],
      "example": "HIRES 1, 0\nCIRCLE 160, 100, 60, 40, 1\nFILL 160, 100, 1 : REM FILL INSIDE CIRCLE"
    },
    {
      "keyword": "REC",
      "prefix": 100,
      "token": 8,
      "type": "command",
      "category": "graphics",
      "syntax": "REC x1, y1, x2, y2, mode",
      "description": "Draw a rectangle outline (four sides, not filled) in hi-res mode. To draw a filled rectangle, use BLOCK instead.",
      "parameters": [
        {
          "name": "x1",
          "type": "integer",
          "range": "0-319",
          "description": "Left X coordinate"
        },
        {
          "name": "y1",
          "type": "integer",
          "range": "0-199",
          "description": "Top Y coordinate"
        },
        {
          "name": "x2",
          "type": "integer",
          "range": "0-319",
          "description": "Right X coordinate"
        },
        {
          "name": "y2",
          "type": "integer",
          "range": "0-199",
          "description": "Bottom Y coordinate"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-2",
          "description": "0=erase, 1=draw, 2=XOR"
        }
      ],
      "example": "HIRES 1, 0\nREC 20, 20, 200, 150, 1 : REM RECTANGLE OUTLINE"
    },
    {
      "keyword": "ROT",
      "prefix": 100,
      "token": 9,
      "type": "command",
      "category": "graphics",
      "syntax": "ROT angle",
      "description": "Rotate the hi-res graphics screen by the specified angle. Angle is in 90-degree increments.",
      "parameters": [
        {
          "name": "angle",
          "type": "integer",
          "range": "0-3",
          "description": "Rotation: 0=0 degrees, 1=90 degrees, 2=180 degrees, 3=270 degrees"
        }
      ],
      "example": "HIRES 1, 0\nLINE 0, 0, 319, 0, 1 : REM TOP EDGE\nROT 1 : REM ROTATE 90 DEGREES"
    },
    {
      "keyword": "DRAW",
      "prefix": 100,
      "token": 10,
      "type": "command",
      "category": "graphics",
      "syntax": "DRAW source, x, y",
      "description": "Draw a predefined shape from a data block to hi-res position (x, y). The source is an address or DATA block index containing the shape definition created with the Simons' BASIC shape editor.",
      "parameters": [
        {
          "name": "source",
          "type": "integer",
          "description": "Address of the shape data block in memory"
        },
        {
          "name": "x",
          "type": "integer",
          "range": "0-319",
          "description": "Target X position"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-199",
          "description": "Target Y position"
        }
      ],
      "example": "HIRES 1, 0\nDRAW 49152, 100, 80 : REM DRAW SHAPE AT $C000"
    },
    {
      "keyword": "CHAR",
      "prefix": 100,
      "token": 11,
      "type": "command",
      "category": "screen",
      "syntax": "CHAR x, y, string$",
      "description": "Print a string at text column x, row y on the screen. Works in both text and hi-res mode.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-39",
          "description": "Text column (0=leftmost)"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-24",
          "description": "Text row (0=top)"
        },
        {
          "name": "string$",
          "type": "string",
          "description": "Text to display"
        }
      ],
      "example": "CHAR 10, 12, \"HELLO SIMONS!\""
    },
    {
      "keyword": "HI COL",
      "prefix": 100,
      "token": 12,
      "type": "command",
      "category": "graphics",
      "syntax": "HI COL x, color",
      "description": "Set the color for hi-res character cell column x. In hi-res mode each character cell can have its own foreground color.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-39",
          "description": "Character cell column (0-39)"
        },
        {
          "name": "color",
          "type": "integer",
          "range": "0-15",
          "description": "Color index for that column"
        }
      ],
      "example": "HIRES 1, 0\nHI COL 20, 7 : REM YELLOW FOREGROUND FOR COLUMN 20"
    },
    {
      "keyword": "INV",
      "prefix": 100,
      "token": 13,
      "type": "command",
      "category": "graphics",
      "syntax": "INV",
      "description": "Invert all pixels on the hi-res screen (set pixels become clear and vice versa).",
      "example": "HIRES 1, 0\nLINE 0, 0, 319, 199, 1\nINV : REM INVERT THE SCREEN"
    },
    {
      "keyword": "FRAC",
      "prefix": 100,
      "token": 14,
      "type": "function",
      "category": "math",
      "syntax": "FRAC(x)",
      "description": "Return the fractional part of x (equivalent to x - INT(x)).",
      "parameters": [
        {
          "name": "x",
          "type": "float",
          "description": "Numeric expression"
        }
      ],
      "example": "PRINT FRAC(3.75)\n.75\nPRINT FRAC(-2.3)\n-.3"
    },
    {
      "keyword": "MOVE",
      "prefix": 100,
      "token": 15,
      "type": "command",
      "category": "memory",
      "syntax": "MOVE source, dest, length",
      "description": "Copy a block of memory from source address to destination address. Length is in bytes. Handles overlapping regions correctly.",
      "parameters": [
        {
          "name": "source",
          "type": "integer",
          "range": "0-65535",
          "description": "Source start address"
        },
        {
          "name": "dest",
          "type": "integer",
          "range": "0-65535",
          "description": "Destination start address"
        },
        {
          "name": "length",
          "type": "integer",
          "range": "1-65535",
          "description": "Number of bytes to copy"
        }
      ],
      "example": "MOVE 1024, 2048, 1000 : REM COPY 1000 BYTES"
    },
    {
      "keyword": "PLACE",
      "prefix": 100,
      "token": 16,
      "type": "command",
      "category": "graphics",
      "syntax": "PLACE shape, x, y",
      "description": "Place a predefined shape at text position (x, y) on the screen using character cell addressing.",
      "parameters": [
        {
          "name": "shape",
          "type": "integer",
          "description": "Shape index or address"
        },
        {
          "name": "x",
          "type": "integer",
          "range": "0-39",
          "description": "Column position"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-24",
          "description": "Row position"
        }
      ],
      "example": "PLACE 1, 20, 12 : REM PLACE SHAPE 1 AT CENTER"
    },
    {
      "keyword": "UPB",
      "prefix": 100,
      "token": 17,
      "type": "command",
      "category": "graphics",
      "syntax": "UPB n",
      "description": "Move the graphics memory pointer up by n bytes. Used with the shape-drawing commands to navigate the hi-res bitmap. Each byte spans 8 horizontal pixels.",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "description": "Number of bytes (8 pixels each) to move up"
        }
      ],
      "example": "UPB 5 : REM MOVE POINTER UP 40 PIXELS (5 BYTES)"
    },
    {
      "keyword": "UPW",
      "prefix": 100,
      "token": 18,
      "type": "command",
      "category": "graphics",
      "syntax": "UPW n",
      "description": "Move the graphics memory pointer up by n words (2 bytes each = 16 horizontal pixels each).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "description": "Number of words to move up"
        }
      ],
      "example": "UPW 2 : REM MOVE POINTER UP 32 PIXELS (2 WORDS)"
    },
    {
      "keyword": "LEFTW",
      "prefix": 100,
      "token": 19,
      "type": "command",
      "category": "graphics",
      "syntax": "LEFTW n",
      "description": "Move the graphics memory pointer left by n words (2 bytes = 16 horizontal pixels each).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "description": "Number of words to move left"
        }
      ],
      "example": "LEFTW 1 : REM MOVE POINTER LEFT 16 PIXELS"
    },
    {
      "keyword": "LEFTB",
      "prefix": 100,
      "token": 20,
      "type": "command",
      "category": "graphics",
      "syntax": "LEFTB n",
      "description": "Move the graphics memory pointer left by n bytes (8 horizontal pixels each).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "description": "Number of bytes to move left"
        }
      ],
      "example": "LEFTB 2 : REM MOVE POINTER LEFT 16 PIXELS"
    },
    {
      "keyword": "DOWNB",
      "prefix": 100,
      "token": 21,
      "type": "command",
      "category": "graphics",
      "syntax": "DOWNB n",
      "description": "Move the graphics memory pointer down by n bytes (8 horizontal pixels each).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "description": "Number of bytes to move down"
        }
      ],
      "example": "DOWNB 5 : REM MOVE POINTER DOWN"
    },
    {
      "keyword": "DOWNW",
      "prefix": 100,
      "token": 22,
      "type": "command",
      "category": "graphics",
      "syntax": "DOWNW n",
      "description": "Move the graphics memory pointer down by n words (2 bytes = 16 horizontal pixels each).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "description": "Number of words to move down"
        }
      ],
      "example": "DOWNW 2 : REM MOVE POINTER DOWN"
    },
    {
      "keyword": "RIGHTB",
      "prefix": 100,
      "token": 23,
      "type": "command",
      "category": "graphics",
      "syntax": "RIGHTB n",
      "description": "Move the graphics memory pointer right by n bytes (8 horizontal pixels each).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "description": "Number of bytes to move right"
        }
      ],
      "example": "RIGHTB 3 : REM MOVE POINTER RIGHT 24 PIXELS"
    },
    {
      "keyword": "RIGHTW",
      "prefix": 100,
      "token": 24,
      "type": "command",
      "category": "graphics",
      "syntax": "RIGHTW n",
      "description": "Move the graphics memory pointer right by n words (2 bytes = 16 horizontal pixels each).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "description": "Number of words to move right"
        }
      ],
      "example": "RIGHTW 1 : REM MOVE POINTER RIGHT 16 PIXELS"
    },
    {
      "keyword": "MULTI",
      "prefix": 100,
      "token": 25,
      "type": "command",
      "category": "graphics",
      "syntax": "MULTI mode",
      "description": "Enable or disable multicolor hi-res mode. In multicolor mode the horizontal resolution is halved (160x200) but four colors are available instead of two.",
      "parameters": [
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=disable multicolor (return to mono hi-res), 1=enable multicolor"
        }
      ],
      "example": "HIRES 1, 0\nMULTI 1 : REM ENABLE MULTICOLOR MODE"
    },
    {
      "keyword": "COLOUR",
      "prefix": 100,
      "token": 26,
      "type": "command",
      "category": "screen",
      "syntax": "COLOUR foreground, background",
      "description": "Set the text foreground and background colors.",
      "parameters": [
        {
          "name": "foreground",
          "type": "integer",
          "range": "0-15",
          "description": "Text foreground color"
        },
        {
          "name": "background",
          "type": "integer",
          "range": "0-15",
          "description": "Screen background color"
        }
      ],
      "example": "COLOUR 1, 6 : REM WHITE ON BLUE\nPRINT \"HELLO\""
    },
    {
      "keyword": "MMOB",
      "prefix": 100,
      "token": 27,
      "type": "command",
      "category": "graphics",
      "syntax": "MMOB sprite, x, y",
      "description": "Move a sprite (MOB — Movable Object Block) to absolute screen position (x, y).",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number"
        },
        {
          "name": "x",
          "type": "integer",
          "range": "0-511",
          "description": "Horizontal position (0-511, with 255 being the right edge for standard sprites)"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-255",
          "description": "Vertical position"
        }
      ],
      "example": "MMOB 0, 160, 100 : REM MOVE SPRITE 0 TO CENTER"
    },
    {
      "keyword": "BFLASH",
      "prefix": 100,
      "token": 28,
      "type": "command",
      "category": "graphics",
      "syntax": "BFLASH sprite, mode",
      "description": "Enable or disable color flashing for a sprite.",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=disable flashing, 1=enable flashing"
        }
      ],
      "example": "BFLASH 0, 1 : REM ENABLE FLASHING ON SPRITE 0"
    },
    {
      "keyword": "MOB SET",
      "prefix": 100,
      "token": 29,
      "type": "command",
      "category": "graphics",
      "syntax": "MOB SET sprite, shape, color, x, y, priority, mode",
      "description": "Configure all parameters for a sprite (MOB) in a single command.",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number"
        },
        {
          "name": "shape",
          "type": "integer",
          "range": "0-255",
          "description": "Sprite shape data block number"
        },
        {
          "name": "color",
          "type": "integer",
          "range": "0-15",
          "description": "Sprite color"
        },
        {
          "name": "x",
          "type": "integer",
          "range": "0-511",
          "description": "Horizontal position"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-255",
          "description": "Vertical position"
        },
        {
          "name": "priority",
          "type": "integer",
          "range": "0-1",
          "description": "0=sprite in front of background, 1=sprite behind background"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=hi-res sprite, 1=multicolor sprite"
        }
      ],
      "example": "MOB SET 0, 1, 1, 160, 100, 0, 0 : REM WHITE HIRES SPRITE AT CENTER"
    },
    {
      "keyword": "MUSIC",
      "prefix": 100,
      "token": 30,
      "type": "command",
      "category": "sound",
      "syntax": "MUSIC note$",
      "description": "Play a music string through the SID chip. The string encodes a sequence of notes in Simons' BASIC music notation. Call MUSIC with an empty string to stop playback.",
      "parameters": [
        {
          "name": "note$",
          "type": "string",
          "description": "Music string in Simons' BASIC notation. Use an empty string to stop."
        }
      ],
      "example": "MUSIC \"CDEFGAB\" : REM PLAY A SCALE\nMUSIC \"\" : REM STOP MUSIC"
    },
    {
      "keyword": "FLASH",
      "prefix": 100,
      "token": 31,
      "type": "command",
      "category": "screen",
      "syntax": "FLASH color1, color2, speed",
      "description": "Flash the screen border between two colors at the given speed.",
      "parameters": [
        {
          "name": "color1",
          "type": "integer",
          "range": "0-15",
          "description": "First border color"
        },
        {
          "name": "color2",
          "type": "integer",
          "range": "0-15",
          "description": "Second border color"
        },
        {
          "name": "speed",
          "type": "integer",
          "range": "1-255",
          "description": "Flash speed (lower=faster)"
        }
      ],
      "example": "FLASH 0, 2, 10 : REM FLASH BETWEEN BLACK AND RED"
    },
    {
      "keyword": "REPEAT",
      "prefix": 100,
      "token": 32,
      "type": "loop",
      "category": "flow",
      "syntax": "REPEAT",
      "description": "Begin a REPEAT/UNTIL loop. The body executes at least once and repeats until the UNTIL condition is true.",
      "example": "X = 0\nREPEAT\n  X = X + 1\n  PRINT X\nUNTIL X >= 10"
    },
    {
      "keyword": "PLAY",
      "prefix": 100,
      "token": 33,
      "type": "command",
      "category": "sound",
      "syntax": "PLAY voice, note, octave, duration",
      "description": "Play a single note on a SID voice. The note is specified as a semitone (0-11) within an octave (0-7). Duration is in jiffies (1/60 sec).",
      "parameters": [
        {
          "name": "voice",
          "type": "integer",
          "range": "1-3",
          "description": "SID voice number"
        },
        {
          "name": "note",
          "type": "integer",
          "range": "0-11",
          "description": "Semitone within the octave: 0=C, 1=C#, 2=D, 3=D#, 4=E, 5=F, 6=F#, 7=G, 8=G#, 9=A, 10=A#, 11=B"
        },
        {
          "name": "octave",
          "type": "integer",
          "range": "0-7",
          "description": "Octave number (4=middle octave)"
        },
        {
          "name": "duration",
          "type": "integer",
          "range": "0-255",
          "description": "Note duration in jiffies (1/60 sec each)"
        }
      ],
      "example": "ENVELOPE 1, 0, 9, 0, 0, 32\nPLAY 1, 0, 4, 30 : REM MIDDLE C FOR HALF SECOND\nPLAY 1, 4, 4, 30 : REM MIDDLE E"
    },
    {
      "keyword": "CENTRE",
      "prefix": 100,
      "token": 35,
      "type": "command",
      "category": "screen",
      "syntax": "CENTRE string$",
      "description": "Print a string horizontally centered on the current screen row.",
      "parameters": [
        {
          "name": "string$",
          "type": "string",
          "description": "Text to center and print"
        }
      ],
      "example": "CENTRE \"SIMONS' BASIC\"\nCENTRE \"PRESS A KEY\""
    },
    {
      "keyword": "ENVELOPE",
      "prefix": 100,
      "token": 36,
      "type": "command",
      "category": "sound",
      "syntax": "ENVELOPE voice, attack, decay, sustain, release, waveform",
      "description": "Set the SID ADSR envelope and waveform for a voice. Must be called before PLAY or SOUND to configure the voice's sound character.",
      "parameters": [
        {
          "name": "voice",
          "type": "integer",
          "range": "1-3",
          "description": "SID voice number"
        },
        {
          "name": "attack",
          "type": "integer",
          "range": "0-15",
          "description": "Attack rate (0=fastest)"
        },
        {
          "name": "decay",
          "type": "integer",
          "range": "0-15",
          "description": "Decay rate"
        },
        {
          "name": "sustain",
          "type": "integer",
          "range": "0-15",
          "description": "Sustain level (0=silent, 15=full volume)"
        },
        {
          "name": "release",
          "type": "integer",
          "range": "0-15",
          "description": "Release rate (0=fastest)"
        },
        {
          "name": "waveform",
          "type": "integer",
          "description": "SID waveform bits: 16=triangle, 32=sawtooth, 64=pulse, 128=noise. These are bit flags and can be combined (e.g. 48=triangle+sawtooth)."
        }
      ],
      "example": "ENVELOPE 1, 0, 9, 0, 0, 32 : REM VOICE 1, SAWTOOTH WAVE\nPLAY 1, 0, 4, 30 : REM MIDDLE C"
    },
    {
      "keyword": "CGOTO",
      "prefix": 100,
      "token": 37,
      "type": "command",
      "category": "flow",
      "syntax": "CGOTO condition, line",
      "description": "Conditional GOTO — branch to line if condition is non-zero (true). More compact than IF/THEN for simple branches.",
      "parameters": [
        {
          "name": "condition",
          "type": "integer",
          "description": "Numeric expression. Branch occurs if this is non-zero."
        },
        {
          "name": "line",
          "type": "integer",
          "description": "Line number to jump to if condition is true"
        }
      ],
      "example": "CGOTO X > 10, 100\nCGOTO A$ = \"Q\", 9000 : REM QUIT HANDLER"
    },
    {
      "keyword": "WAVE",
      "prefix": 100,
      "token": 38,
      "type": "command",
      "category": "sound",
      "syntax": "WAVE voice, waveform",
      "description": "Set the waveform for a SID voice without changing the ADSR envelope.",
      "parameters": [
        {
          "name": "voice",
          "type": "integer",
          "range": "1-3",
          "description": "SID voice number"
        },
        {
          "name": "waveform",
          "type": "integer",
          "description": "SID waveform bits: 16=triangle, 32=sawtooth, 64=pulse, 128=noise"
        }
      ],
      "example": "WAVE 1, 32 : REM SAWTOOTH ON VOICE 1\nWAVE 2, 64 : REM PULSE ON VOICE 2"
    },
    {
      "keyword": "FETCH",
      "prefix": 100,
      "token": 39,
      "type": "command",
      "category": "memory",
      "syntax": "FETCH address, variable",
      "description": "Read a byte from memory address into a numeric variable. Similar to PEEK but uses a Simons' BASIC command form.",
      "parameters": [
        {
          "name": "address",
          "type": "integer",
          "range": "0-65535",
          "description": "Memory address to read from"
        },
        {
          "name": "variable",
          "type": "integer",
          "description": "Numeric variable to receive the value (0-255)"
        }
      ],
      "example": "FETCH 53280, C : PRINT \"BORDER COLOR:\"; C"
    },
    {
      "keyword": "AT(",
      "prefix": 100,
      "token": 40,
      "type": "function",
      "category": "screen",
      "syntax": "AT(x, y)",
      "description": "Return the PETSCII character code at screen text position (x, y).",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-39",
          "description": "Screen column"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-24",
          "description": "Screen row"
        }
      ],
      "example": "PRINT \"HELLO\"\nPRINT AT(0, 0) : REM PRINTS 72 (='H')"
    },
    {
      "keyword": "UNTIL",
      "prefix": 100,
      "token": 41,
      "type": "loop",
      "category": "flow",
      "syntax": "UNTIL condition",
      "description": "End a REPEAT/UNTIL loop. Loop repeats while condition is false (zero). Exits when condition is true (non-zero).",
      "parameters": [
        {
          "name": "condition",
          "type": "integer",
          "description": "Loop exits when this expression is non-zero"
        }
      ],
      "example": "X = 0\nREPEAT\n  X = X + 1\nUNTIL X >= 10\nPRINT \"DONE:\"; X"
    },
    {
      "keyword": "USE",
      "prefix": 100,
      "token": 44,
      "type": "command",
      "category": "system",
      "syntax": "USE n",
      "description": "Select which character set to use for display. 0=uppercase/graphics, 1=lowercase/uppercase.",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "0-1",
          "description": "0=uppercase/graphics character set, 1=lowercase/uppercase character set"
        }
      ],
      "example": "USE 1 : REM LOWERCASE MODE"
    },
    {
      "keyword": "GLOBAL",
      "prefix": 100,
      "token": 46,
      "type": "command",
      "category": "flow",
      "syntax": "GLOBAL variable",
      "description": "Declare a variable as global within a PROC definition. Global variables retain their values across PROC calls and are accessible outside the PROC.",
      "parameters": [
        {
          "name": "variable",
          "description": "Variable name to declare as global"
        }
      ],
      "example": "PROC MYPROC\n  GLOBAL SCORE\n  SCORE = SCORE + 10\nEND PROC"
    },
    {
      "keyword": "RESET",
      "prefix": 100,
      "token": 48,
      "type": "command",
      "category": "graphics",
      "syntax": "RESET",
      "description": "Clear the hi-res graphics screen (set all pixels to background color).",
      "example": "HIRES 1, 0\nLINE 0, 0, 319, 199, 1\nRESET : REM CLEAR THE HI-RES SCREEN"
    },
    {
      "keyword": "PROC",
      "prefix": 100,
      "token": 49,
      "type": "command",
      "category": "flow",
      "syntax": "PROC name",
      "description": "Define the start of a named procedure. Procedures allow structured programming by grouping code under a name. Call with CALL or EXEC. End the procedure with END PROC.",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "Procedure name (identifier)"
        }
      ],
      "example": "PROC GREET\n  PRINT \"HELLO!\"\nEND PROC\nCALL GREET"
    },
    {
      "keyword": "CALL",
      "prefix": 100,
      "token": 50,
      "type": "command",
      "category": "flow",
      "syntax": "CALL name",
      "description": "Call a named procedure defined with PROC. Execution jumps to the PROC body and returns after END PROC.",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "Name of the procedure to call"
        }
      ],
      "example": "CALL GREET\nCALL DRAW_SHIP"
    },
    {
      "keyword": "EXEC",
      "prefix": 100,
      "token": 51,
      "type": "command",
      "category": "flow",
      "syntax": "EXEC name",
      "description": "Execute a named procedure. Alias for CALL — both invoke a procedure defined with PROC.",
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "Name of the procedure to execute"
        }
      ],
      "example": "EXEC GREET"
    },
    {
      "keyword": "END PROC",
      "prefix": 100,
      "token": 52,
      "type": "command",
      "category": "flow",
      "syntax": "END PROC",
      "description": "Mark the end of a PROC definition. Returns execution to the caller.",
      "example": "PROC MYPROC\n  PRINT \"IN PROC\"\nEND PROC"
    },
    {
      "keyword": "EXIT",
      "prefix": 100,
      "token": 53,
      "type": "command",
      "category": "flow",
      "syntax": "EXIT",
      "description": "Immediately exit the current PROC, LOOP, or REPEAT block. Execution continues after the enclosing END PROC, END LOOP, or next statement.",
      "example": "REPEAT\n  INPUT \"Q TO QUIT\"; A$\n  CGOTO A$ = \"Q\", 9000\nUNTIL 0 : REM INFINITE — EXIT INSIDE"
    },
    {
      "keyword": "END LOOP",
      "prefix": 100,
      "token": 54,
      "type": "loop",
      "category": "flow",
      "syntax": "END LOOP",
      "description": "Mark the end of a LOOP block. Execution returns to the matching LOOP statement (infinite loop unless EXIT is used inside).",
      "example": "X = 0\nLOOP\n  X = X + 1\n  IF X = 10 THEN:EXIT\nEND LOOP\nPRINT \"DONE:\"; X"
    },
    {
      "keyword": "ON KEY",
      "prefix": 100,
      "token": 55,
      "type": "command",
      "category": "io",
      "syntax": "ON KEY string$, line",
      "description": "Install a key handler. When the specified key is pressed, program execution jumps to the given line number. Use DISABLE to remove the handler.",
      "parameters": [
        {
          "name": "string$",
          "type": "string",
          "description": "Single character string — the key to trap"
        },
        {
          "name": "line",
          "type": "integer",
          "description": "Line number to jump to when the key is pressed"
        }
      ],
      "example": "ON KEY \"Q\", 9000\nGOTO 10 : REM MAIN LOOP\n9000 PRINT \"QUIT\": END"
    },
    {
      "keyword": "DISABLE",
      "prefix": 100,
      "token": 56,
      "type": "command",
      "category": "io",
      "syntax": "DISABLE",
      "description": "Disable the ON KEY handler installed with ON KEY.",
      "example": "ON KEY \"Q\", 9000\nDISABLE : REM REMOVE KEY HANDLER"
    },
    {
      "keyword": "RESUME",
      "prefix": 100,
      "token": 57,
      "type": "command",
      "category": "flow",
      "syntax": "RESUME [line]",
      "description": "Resume execution after an ON ERROR handler. Without a line number, resumes at the statement that caused the error. With a line number, resumes at that line.",
      "parameters": [
        {
          "name": "line",
          "type": "integer",
          "description": "Line number to resume at (optional — default resumes at the error location)",
          "optional": true
        }
      ],
      "example": "ON ERROR 9000\n...\n9000 PRINT \"ERROR:\"; ERR : RESUME 10"
    },
    {
      "keyword": "LOOP",
      "prefix": 100,
      "token": 58,
      "type": "loop",
      "category": "flow",
      "syntax": "LOOP",
      "description": "Begin an infinite loop block. Loop runs forever until EXIT is encountered inside the body, or GOTO jumps out of it.",
      "example": "X = 0\nLOOP\n  X = X + 1\n  IF X > 100 THEN:EXIT\nEND LOOP"
    },
    {
      "keyword": "DELAY",
      "prefix": 100,
      "token": 59,
      "type": "command",
      "category": "system",
      "syntax": "DELAY n",
      "description": "Pause program execution for n jiffies (1/60 of a second each).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "1-65535",
          "description": "Number of jiffies to wait (60 = 1 second)"
        }
      ],
      "example": "DELAY 60 : REM WAIT ONE SECOND\nDELAY 300 : REM WAIT 5 SECONDS"
    },
    {
      "keyword": "SECURE",
      "prefix": 100,
      "token": 64,
      "type": "command",
      "category": "system",
      "syntax": "SECURE",
      "description": "Protect the current program from being listed with the LIST command. The program can still be RUN but its source code cannot be viewed.",
      "example": "SECURE : REM PROTECT FROM LISTING"
    },
    {
      "keyword": "DISAPA",
      "prefix": 100,
      "token": 65,
      "type": "command",
      "category": "graphics",
      "syntax": "DISAPA sprite",
      "description": "Make a sprite disappear by disabling it. The sprite shape and position are preserved; use MOB SET or MMOB to re-enable.",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number to disable"
        }
      ],
      "example": "DISAPA 0 : REM HIDE SPRITE 0"
    },
    {
      "keyword": "CIRCLE",
      "prefix": 100,
      "token": 66,
      "type": "command",
      "category": "graphics",
      "syntax": "CIRCLE x, y, rx, ry, mode",
      "description": "Draw a circle or ellipse in hi-res mode. Specify equal radii for a circle; different radii for an ellipse.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-319",
          "description": "Centre X coordinate"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-199",
          "description": "Centre Y coordinate"
        },
        {
          "name": "rx",
          "type": "integer",
          "description": "Horizontal radius in pixels"
        },
        {
          "name": "ry",
          "type": "integer",
          "description": "Vertical radius in pixels"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=erase, 1=draw"
        }
      ],
      "example": "HIRES 1, 0\nCIRCLE 160, 100, 80, 50, 1 : REM ELLIPSE"
    },
    {
      "keyword": "ON ERROR",
      "prefix": 100,
      "token": 67,
      "type": "command",
      "category": "flow",
      "syntax": "ON ERROR line",
      "description": "Install a global error trap. When any BASIC error occurs, execution jumps to the specified line. Use ERR to identify the error, and RESUME to continue. Disable with NO ERROR.",
      "parameters": [
        {
          "name": "line",
          "type": "integer",
          "description": "Line number to jump to on any error"
        }
      ],
      "example": "ON ERROR 9000\n...\n9000 PRINT \"ERR #\"; ERR : NO ERROR : END"
    },
    {
      "keyword": "NO ERROR",
      "prefix": 100,
      "token": 68,
      "type": "command",
      "category": "flow",
      "syntax": "NO ERROR",
      "description": "Disable the ON ERROR trap, restoring the default error handling behavior.",
      "example": "ON ERROR 9000\n...\n9000 NO ERROR : PRINT \"ERROR CLEARED\""
    },
    {
      "keyword": "LOCAL",
      "prefix": 100,
      "token": 69,
      "type": "command",
      "category": "flow",
      "syntax": "LOCAL variable",
      "description": "Declare a local variable within a PROC. The variable's value is saved on entry and restored on exit, isolating it from the rest of the program.",
      "parameters": [
        {
          "name": "variable",
          "description": "Variable name to declare as local to the current PROC"
        }
      ],
      "example": "PROC MYPROC\n  LOCAL I\n  FOR I = 1 TO 10: PRINT I: NEXT I\nEND PROC"
    },
    {
      "keyword": "RCOMP",
      "prefix": 100,
      "token": 70,
      "type": "function",
      "category": "graphics",
      "syntax": "RCOMP",
      "description": "Read the VIC-II sprite collision registers and return the collision status. Returns a bitmask where each bit represents a sprite involved in a collision.",
      "example": "C = RCOMP\nIF C AND 1 THEN PRINT \"SPRITE 0 COLLIDED\""
    },
    {
      "keyword": "ELSE",
      "prefix": 100,
      "token": 71,
      "type": "conditional",
      "category": "flow",
      "syntax": "IF condition THEN statement ELSE alternative",
      "description": "Provides an alternative branch in an IF/THEN statement. Executes the alternative if the condition is false. Note: Simons' BASIC keywords after THEN or ELSE require a preceding colon (THEN:KEYWORD).",
      "example": "IF X > 10 THEN PRINT \"BIG\" ELSE PRINT \"SMALL\""
    },
    {
      "keyword": "RETRACE",
      "prefix": 100,
      "token": 72,
      "type": "command",
      "category": "system",
      "syntax": "RETRACE",
      "description": "Wait for the next vertical retrace (raster sync) before continuing. Useful for smooth sprite or graphics updates — synchronizes updates to the display refresh cycle.",
      "example": "RETRACE\nMMOB 0, X, Y : REM UPDATE SPRITE IN SYNC"
    },
    {
      "keyword": "TRACE",
      "prefix": 100,
      "token": 73,
      "type": "command",
      "category": "system",
      "syntax": "TRACE mode",
      "description": "Enable or disable program trace mode. When enabled, each line number is printed as it is executed, useful for debugging.",
      "parameters": [
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=disable trace, 1=enable trace"
        }
      ],
      "example": "TRACE 1 : REM ENABLE TRACING\nGOSUB 1000\nTRACE 0 : REM DISABLE TRACING"
    },
    {
      "keyword": "DIR",
      "prefix": 100,
      "token": 74,
      "type": "command",
      "category": "io",
      "syntax": "DIR [pattern]",
      "description": "List the disk directory. An optional filename pattern filters the listing. The $ pattern lists all files.",
      "parameters": [
        {
          "name": "pattern",
          "type": "string",
          "description": "Optional filename filter (e.g. \"*.BAS\"). Wildcards * and ? are supported.",
          "optional": true
        }
      ],
      "example": "DIR : REM LIST ALL FILES\nDIR \"P*\" : REM FILES STARTING WITH P"
    },
    {
      "keyword": "PAGE",
      "prefix": 100,
      "token": 75,
      "type": "command",
      "category": "screen",
      "syntax": "PAGE start, end",
      "description": "Set the screen scrolling region to the rows between start and end. Scroll operations are confined to this area.",
      "parameters": [
        {
          "name": "start",
          "type": "integer",
          "range": "0-24",
          "description": "First row of the scrolling region"
        },
        {
          "name": "end",
          "type": "integer",
          "range": "0-24",
          "description": "Last row of the scrolling region"
        }
      ],
      "example": "PAGE 2, 22 : REM SCROLL ROWS 2-22 ONLY"
    },
    {
      "keyword": "DUMP",
      "prefix": 100,
      "token": 76,
      "type": "command",
      "category": "system",
      "syntax": "DUMP",
      "description": "Display all current variable names and their values. Useful for debugging.",
      "example": "X = 42 : A$ = \"HELLO\"\nDUMP : REM DISPLAY ALL VARIABLES"
    },
    {
      "keyword": "FIND",
      "prefix": 100,
      "token": 77,
      "type": "command",
      "category": "editor",
      "syntax": "FIND string$",
      "description": "Search the program listing for all occurrences of the given string and display the matching lines.",
      "parameters": [
        {
          "name": "string$",
          "type": "string",
          "description": "Text to search for in the program listing"
        }
      ],
      "example": "FIND \"PRINT\"\nFIND \"GOSUB\""
    },
    {
      "keyword": "OPTION",
      "prefix": 100,
      "token": 78,
      "type": "command",
      "category": "system",
      "syntax": "OPTION mode",
      "description": "Set Simons' BASIC system options that control interpreter behavior.",
      "parameters": [
        {
          "name": "mode",
          "type": "integer",
          "description": "Option mode value (see Simons' BASIC manual for specific option flags)"
        }
      ],
      "example": "OPTION 1"
    },
    {
      "keyword": "AUTO",
      "prefix": 100,
      "token": 79,
      "type": "command",
      "category": "editor",
      "syntax": "AUTO [start [, step]]",
      "description": "Enable automatic line numbering for the editor. Each time RETURN is pressed, the next line number is generated automatically.",
      "parameters": [
        {
          "name": "start",
          "type": "integer",
          "description": "Starting line number (default: 10)",
          "optional": true
        },
        {
          "name": "step",
          "type": "integer",
          "description": "Increment between line numbers (default: 10)",
          "optional": true
        }
      ],
      "example": "AUTO 100, 10 : REM START AT 100, STEP 10\nAUTO : REM USE DEFAULTS"
    },
    {
      "keyword": "OLD",
      "prefix": 100,
      "token": 80,
      "type": "command",
      "category": "system",
      "syntax": "OLD",
      "description": "Recover a program deleted with the NEW command by restoring the end-of-program pointer. Only works if no new data has overwritten BASIC memory since NEW was executed.",
      "example": "NEW : REM CLEARS PROGRAM\nOLD : REM ATTEMPT RECOVERY"
    },
    {
      "keyword": "JOY",
      "prefix": 100,
      "token": 81,
      "type": "function",
      "category": "io",
      "syntax": "JOY(port)",
      "description": "Read the joystick state for port 1 or 2. Returns a bitmask where bit 4=fire, bit 3=right, bit 2=left, bit 1=down, bit 0=up.",
      "parameters": [
        {
          "name": "port",
          "type": "integer",
          "range": "1-2",
          "description": "Joystick port number"
        }
      ],
      "example": "J = JOY(1)\nIF J AND 16 THEN PRINT \"FIRE!\"\nIF J AND 1 THEN PRINT \"UP\"\nIF J AND 2 THEN PRINT \"DOWN\""
    },
    {
      "keyword": "MOD",
      "prefix": 100,
      "token": 82,
      "type": "function",
      "category": "math",
      "syntax": "MOD(a, b)",
      "description": "Return the modulo (remainder) of a divided by b.",
      "parameters": [
        {
          "name": "a",
          "type": "integer",
          "description": "Dividend"
        },
        {
          "name": "b",
          "type": "integer",
          "description": "Divisor (must not be zero)"
        }
      ],
      "example": "PRINT MOD(10, 3)\n1\nPRINT MOD(17, 5)\n2"
    },
    {
      "keyword": "DIV",
      "prefix": 100,
      "token": 83,
      "type": "function",
      "category": "math",
      "syntax": "DIV(a, b)",
      "description": "Return the integer quotient of a divided by b (truncates toward zero).",
      "parameters": [
        {
          "name": "a",
          "type": "integer",
          "description": "Dividend"
        },
        {
          "name": "b",
          "type": "integer",
          "description": "Divisor (must not be zero)"
        }
      ],
      "example": "PRINT DIV(10, 3)\n3\nPRINT DIV(17, 5)\n3"
    },
    {
      "keyword": "DUP",
      "prefix": 100,
      "token": 85,
      "type": "command",
      "category": "screen",
      "syntax": "DUP",
      "description": "Duplicate the current screen line — inserts a copy of the current cursor line below it.",
      "example": "PRINT \"LINE TO COPY\"\nDUP : REM DUPLICATES THE LINE"
    },
    {
      "keyword": "INKEY",
      "prefix": 100,
      "token": 86,
      "type": "function",
      "category": "io",
      "syntax": "INKEY",
      "description": "Read one character from the keyboard buffer without waiting. Returns an empty string if no key is waiting. Unlike GET, INKEY can be used in an expression.",
      "example": "10 K$ = INKEY\nIF K$ = \"\" THEN GOTO 10 : REM WAIT FOR KEY\nIF K$ = \"Q\" THEN END"
    },
    {
      "keyword": "INST",
      "prefix": 100,
      "token": 87,
      "type": "function",
      "category": "string",
      "syntax": "INST(string$, search$)",
      "description": "Search for search$ inside string$. Returns the 1-based position of the first occurrence, or 0 if not found.",
      "parameters": [
        {
          "name": "string$",
          "type": "string",
          "description": "String to search in"
        },
        {
          "name": "search$",
          "type": "string",
          "description": "Substring to search for"
        }
      ],
      "example": "PRINT INST(\"HELLO WORLD\", \"WORLD\")\n7\nPRINT INST(\"HELLO\", \"XYZ\")\n0"
    },
    {
      "keyword": "TEST",
      "prefix": 100,
      "token": 88,
      "type": "function",
      "category": "graphics",
      "syntax": "TEST(x, y)",
      "description": "Return the state of the pixel at hi-res position (x, y). Returns 0 if the pixel is off (background), 1 if on (foreground).",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-319",
          "description": "X pixel coordinate"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-199",
          "description": "Y pixel coordinate"
        }
      ],
      "example": "HIRES 1, 0\nPLOT 100, 50, 1\nIF TEST(100, 50) THEN PRINT \"PIXEL IS SET\""
    },
    {
      "keyword": "LIN",
      "prefix": 100,
      "token": 89,
      "type": "function",
      "category": "screen",
      "syntax": "LIN(n)",
      "description": "Return a string of n newline (carriage return) characters.",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "1-255",
          "description": "Number of newline characters to generate"
        }
      ],
      "example": "PRINT LIN(3) : REM SKIP 3 LINES\nPRINT \"AFTER BLANK LINES\""
    },
    {
      "keyword": "EXOR",
      "prefix": 100,
      "token": 90,
      "type": "function",
      "category": "math",
      "syntax": "EXOR(a, b)",
      "description": "Return the bitwise exclusive OR (XOR) of integers a and b.",
      "parameters": [
        {
          "name": "a",
          "type": "integer",
          "description": "First operand"
        },
        {
          "name": "b",
          "type": "integer",
          "description": "Second operand"
        }
      ],
      "example": "PRINT EXOR(255, 15)\n240\nPRINT EXOR(170, 85)\n255"
    },
    {
      "keyword": "INSERT",
      "prefix": 100,
      "token": 91,
      "type": "command",
      "category": "string",
      "syntax": "INSERT string$, pos, insert$",
      "description": "Insert insert$ into string$ at character position pos (1-based). The characters from pos onwards are shifted right.",
      "parameters": [
        {
          "name": "string$",
          "type": "string",
          "description": "Target string variable to modify in place"
        },
        {
          "name": "pos",
          "type": "integer",
          "range": "1-255",
          "description": "Position to insert at (1=before first character)"
        },
        {
          "name": "insert$",
          "type": "string",
          "description": "String to insert"
        }
      ],
      "example": "A$ = \"HELO\"\nINSERT A$, 3, \"L\"\nPRINT A$\nHELLO"
    },
    {
      "keyword": "POT",
      "prefix": 100,
      "token": 92,
      "type": "function",
      "category": "io",
      "syntax": "POT(n)",
      "description": "Read the current value of a paddle (potentiometer) controller. Returns 0-255.",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "1-4",
          "description": "Paddle number: 1=port1 paddle A, 2=port1 paddle B, 3=port2 paddle A, 4=port2 paddle B"
        }
      ],
      "example": "P = POT(1) : PRINT \"PADDLE:\"; P"
    },
    {
      "keyword": "PENX",
      "prefix": 100,
      "token": 93,
      "type": "function",
      "category": "io",
      "syntax": "PENX",
      "description": "Return the X (horizontal) raster position where the lightpen last triggered.",
      "example": "X = PENX : Y = PENY\nPRINT \"LIGHTPEN AT\"; X; \",\"; Y"
    },
    {
      "keyword": "PENY",
      "prefix": 100,
      "token": 95,
      "type": "function",
      "category": "io",
      "syntax": "PENY",
      "description": "Return the Y (vertical) raster position where the lightpen last triggered.",
      "example": "X = PENX : Y = PENY\nPRINT \"LIGHTPEN AT\"; X; \",\"; Y"
    },
    {
      "keyword": "SOUND",
      "prefix": 100,
      "token": 96,
      "type": "command",
      "category": "sound",
      "syntax": "SOUND voice, frequency, duration",
      "description": "Generate a sound on a SID voice at the given raw frequency for the given duration in jiffies. Unlike PLAY, SOUND takes a raw SID frequency value (0-65535) rather than a note name.",
      "parameters": [
        {
          "name": "voice",
          "type": "integer",
          "range": "1-3",
          "description": "SID voice number"
        },
        {
          "name": "frequency",
          "type": "integer",
          "range": "0-65535",
          "description": "Raw SID frequency register value"
        },
        {
          "name": "duration",
          "type": "integer",
          "range": "0-255",
          "description": "Duration in jiffies (1/60 sec each)"
        }
      ],
      "example": "ENVELOPE 1, 0, 9, 0, 0, 32\nSOUND 1, 4400, 30 : REM APPROX MIDDLE A"
    },
    {
      "keyword": "GRAPHICS",
      "prefix": 100,
      "token": 97,
      "type": "command",
      "category": "graphics",
      "syntax": "GRAPHICS mode",
      "description": "Set the graphics display mode. Alias for HIRES/NRM with mode selection: 0=return to text, 1=hi-res, 2=multicolor.",
      "parameters": [
        {
          "name": "mode",
          "type": "integer",
          "range": "0-2",
          "description": "0=text mode, 1=hi-resolution, 2=multicolor hi-res"
        }
      ],
      "example": "GRAPHICS 1 : REM ENTER HI-RES\nGRAPHICS 0 : REM RETURN TO TEXT"
    },
    {
      "keyword": "DESIGN",
      "prefix": 100,
      "token": 98,
      "type": "command",
      "category": "graphics",
      "syntax": "DESIGN sprite, row, data",
      "description": "Define a row of pixel data for a sprite shape. Used to build sprite bitmaps programmatically.",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number to define"
        },
        {
          "name": "row",
          "type": "integer",
          "range": "0-20",
          "description": "Row within the sprite (sprite is 21 rows tall)"
        },
        {
          "name": "data",
          "type": "integer",
          "range": "0-16777215",
          "description": "24-bit value encoding 24 pixels (3 bytes) for this row"
        }
      ],
      "example": "DESIGN 0, 10, 16711680 : REM SET ROW 10 OF SPRITE 0"
    },
    {
      "keyword": "RLOCMOB",
      "prefix": 100,
      "token": 99,
      "type": "function",
      "category": "graphics",
      "syntax": "RLOCMOB(sprite, axis)",
      "description": "Read the current screen position of a sprite. Returns X or Y coordinate.",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number"
        },
        {
          "name": "axis",
          "type": "integer",
          "range": "0-1",
          "description": "0=X position, 1=Y position"
        }
      ],
      "example": "X = RLOCMOB(0, 0)\nY = RLOCMOB(0, 1)\nPRINT \"SPRITE 0 AT\"; X; \",\"; Y"
    },
    {
      "keyword": "CMOB",
      "prefix": 100,
      "token": 100,
      "type": "function",
      "category": "graphics",
      "syntax": "CMOB(sprite)",
      "description": "Check sprite-to-sprite collision for the given sprite. Returns a bitmask where each bit represents whether that sprite has collided with the given sprite.",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number to check collisions for"
        }
      ],
      "example": "IF CMOB(0) AND 2 THEN PRINT \"SPRITE 0 HIT SPRITE 1\""
    },
    {
      "keyword": "BCKGNDS",
      "prefix": 100,
      "token": 101,
      "type": "command",
      "category": "graphics",
      "syntax": "BCKGNDS color",
      "description": "Set the background color for the hi-res graphics screen.",
      "parameters": [
        {
          "name": "color",
          "type": "integer",
          "range": "0-15",
          "description": "Background color index"
        }
      ],
      "example": "HIRES 1, 0\nBCKGNDS 6 : REM BLUE BACKGROUND"
    },
    {
      "keyword": "PAUSE",
      "prefix": 100,
      "token": 102,
      "type": "command",
      "category": "system",
      "syntax": "PAUSE n",
      "description": "Pause execution for n jiffies, or until a key is pressed (whichever comes first).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "0-65535",
          "description": "Maximum wait time in jiffies (0=wait for key only)"
        }
      ],
      "example": "PAUSE 120 : REM WAIT UP TO 2 SECONDS OR A KEY\nPAUSE 0 : REM WAIT INDEFINITELY FOR A KEY"
    },
    {
      "keyword": "NRM",
      "prefix": 100,
      "token": 103,
      "type": "command",
      "category": "system",
      "syntax": "NRM",
      "description": "Return to normal text mode, exiting hi-res graphics. Equivalent to GRAPHICS 0 or HIRES 0, 0.",
      "example": "HIRES 1, 0\nLINE 0, 0, 319, 199, 1\nPAUSE 180\nNRM : REM BACK TO TEXT"
    },
    {
      "keyword": "MOB OFF",
      "prefix": 100,
      "token": 104,
      "type": "command",
      "category": "graphics",
      "syntax": "MOB OFF sprite",
      "description": "Disable a specific sprite, making it invisible. The sprite's data is not erased.",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number to disable"
        }
      ],
      "example": "MOB OFF 0 : REM DISABLE SPRITE 0\nMOB OFF 3 : REM DISABLE SPRITE 3"
    },
    {
      "keyword": "OFF",
      "prefix": 100,
      "token": 105,
      "type": "command",
      "category": "system",
      "syntax": "OFF",
      "description": "Disable all sprites simultaneously.",
      "example": "OFF : REM TURN OFF ALL 8 SPRITES AT ONCE"
    },
    {
      "keyword": "ANGL",
      "prefix": 100,
      "token": 106,
      "type": "function",
      "category": "math",
      "syntax": "ANGL(x1, y1, x2, y2)",
      "description": "Return the angle in degrees between the vector from (x1,y1) to (x2,y2) and the positive X axis.",
      "parameters": [
        {
          "name": "x1",
          "type": "integer",
          "description": "Starting X coordinate"
        },
        {
          "name": "y1",
          "type": "integer",
          "description": "Starting Y coordinate"
        },
        {
          "name": "x2",
          "type": "integer",
          "description": "Ending X coordinate"
        },
        {
          "name": "y2",
          "type": "integer",
          "description": "Ending Y coordinate"
        }
      ],
      "example": "A = ANGL(0, 0, 10, 10)\nPRINT \"ANGLE:\"; A : REM PRINTS ~45"
    },
    {
      "keyword": "ARC",
      "prefix": 100,
      "token": 107,
      "type": "command",
      "category": "graphics",
      "syntax": "ARC x, y, r, start, end, mode",
      "description": "Draw an arc (portion of a circle) in hi-res mode. Start and end angles are in degrees.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "description": "Centre X coordinate"
        },
        {
          "name": "y",
          "type": "integer",
          "description": "Centre Y coordinate"
        },
        {
          "name": "r",
          "type": "integer",
          "description": "Radius in pixels"
        },
        {
          "name": "start",
          "type": "integer",
          "range": "0-360",
          "description": "Starting angle in degrees"
        },
        {
          "name": "end",
          "type": "integer",
          "range": "0-360",
          "description": "Ending angle in degrees"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=erase, 1=draw"
        }
      ],
      "example": "HIRES 1, 0\nARC 160, 100, 60, 0, 180, 1 : REM UPPER SEMICIRCLE"
    },
    {
      "keyword": "COLD",
      "prefix": 100,
      "token": 108,
      "type": "command",
      "category": "system",
      "syntax": "COLD",
      "description": "Perform a cold restart of Simons' BASIC — reinitializes the interpreter and clears all program and variable memory.",
      "example": "COLD : REM FULL RESET"
    },
    {
      "keyword": "SCRSV",
      "prefix": 100,
      "token": 109,
      "type": "command",
      "category": "screen",
      "syntax": "SCRSV",
      "description": "Save the current screen contents to an internal memory buffer.",
      "example": "SCRSV : REM SAVE SCREEN\nPRINT \"TEMPORARY MESSAGE\"\nDELAY 180\nSCRLD : REM RESTORE SCREEN"
    },
    {
      "keyword": "SCRLD",
      "prefix": 100,
      "token": 110,
      "type": "command",
      "category": "screen",
      "syntax": "SCRLD",
      "description": "Restore the screen contents from the buffer saved with SCRSV.",
      "example": "SCRSV\nCHAR 10, 12, \"LOADING...\"\nDELAY 300\nSCRLD : REM RESTORE ORIGINAL SCREEN"
    },
    {
      "keyword": "TEXT",
      "prefix": 100,
      "token": 111,
      "type": "command",
      "category": "screen",
      "syntax": "TEXT",
      "description": "Switch from hi-res graphics mode back to normal text mode. Alias for NRM.",
      "example": "HIRES 1, 0\nLINE 0, 100, 319, 100, 1\nDELAY 120\nTEXT : REM BACK TO TEXT MODE"
    },
    {
      "keyword": "CSET",
      "prefix": 100,
      "token": 112,
      "type": "command",
      "category": "screen",
      "syntax": "CSET n",
      "description": "Select the active character set. 0=uppercase/graphics (the C64 default), 1=lowercase/uppercase.",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "0-1",
          "description": "0=uppercase/graphics character set, 1=lowercase/uppercase character set"
        }
      ],
      "example": "CSET 1 : REM LOWERCASE MODE\nPRINT \"Hello World\"\nCSET 0 : REM BACK TO UPPERCASE"
    },
    {
      "keyword": "VOL",
      "prefix": 100,
      "token": 113,
      "type": "command",
      "category": "sound",
      "syntax": "VOL n",
      "description": "Set the SID chip master volume (affects all three voices).",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "0-15",
          "description": "Master volume level (0=silence, 15=maximum)"
        }
      ],
      "example": "VOL 15 : REM FULL VOLUME\nENVELOPE 1, 0, 9, 0, 0, 32\nPLAY 1, 0, 4, 60"
    },
    {
      "keyword": "DISK",
      "prefix": 100,
      "token": 114,
      "type": "command",
      "category": "io",
      "syntax": "DISK command$",
      "description": "Send a command string directly to the disk drive via the command channel.",
      "parameters": [
        {
          "name": "command$",
          "type": "string",
          "description": "DOS command string (e.g. \"I0\" to initialize, \"S:FILE\" to scratch)"
        }
      ],
      "example": "DISK \"I0\" : REM INITIALIZE DRIVE\nDISK \"S:OLDFILE\" : REM SCRATCH FILE"
    },
    {
      "keyword": "HRDCPY",
      "prefix": 100,
      "token": 115,
      "type": "command",
      "category": "io",
      "syntax": "HRDCPY",
      "description": "Print a hardcopy of the current screen contents to the printer on device 4.",
      "example": "HRDCPY : REM PRINT SCREEN TO PRINTER"
    },
    {
      "keyword": "KEY",
      "prefix": 100,
      "token": 116,
      "type": "command",
      "category": "system",
      "syntax": "KEY n, string$",
      "description": "Assign a string to function key n. When that function key is pressed, the string is typed as keyboard input.",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "1-8",
          "description": "Function key number (1-8)"
        },
        {
          "name": "string$",
          "type": "string",
          "description": "String to type when the key is pressed"
        }
      ],
      "example": "KEY 1, \"RUN\"\nKEY 2, \"LIST\"\nKEY 8, \"HIRES 0,0\""
    },
    {
      "keyword": "PAINT",
      "prefix": 100,
      "token": 117,
      "type": "command",
      "category": "graphics",
      "syntax": "PAINT x, y, mode",
      "description": "Paint (flood fill) an area in hi-res mode starting at (x, y), filling adjacent pixels of the same state. PAINT fills from the seed point outward, stopping at pixels with a different state. See also FILL, which may differ in boundary detection behavior.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "range": "0-319",
          "description": "Seed X coordinate — fill starts here"
        },
        {
          "name": "y",
          "type": "integer",
          "range": "0-199",
          "description": "Seed Y coordinate"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=paint with background, 1=paint with foreground"
        }
      ],
      "example": "HIRES 1, 0\nREC 50, 50, 200, 150, 1\nPAINT 125, 100, 1 : REM FILL INSIDE RECTANGLE"
    },
    {
      "keyword": "LOW COL",
      "prefix": 100,
      "token": 118,
      "type": "command",
      "category": "graphics",
      "syntax": "LOW COL color",
      "description": "Set the lo-resolution (background) color used in hi-res mode.",
      "parameters": [
        {
          "name": "color",
          "type": "integer",
          "range": "0-15",
          "description": "Lo-res background color index"
        }
      ],
      "example": "HIRES 1, 0\nLOW COL 6 : REM BLUE LO-RES BACKGROUND"
    },
    {
      "keyword": "COPY",
      "prefix": 100,
      "token": 119,
      "type": "command",
      "category": "io",
      "syntax": "COPY \"source\" TO \"dest\"",
      "description": "Copy a file from source to destination on the same disk.",
      "parameters": [
        {
          "name": "source",
          "type": "string",
          "description": "Source filename"
        },
        {
          "name": "dest",
          "type": "string",
          "description": "Destination filename"
        }
      ],
      "example": "COPY \"PROG\" TO \"BACKUP\""
    },
    {
      "keyword": "MERGE",
      "prefix": 100,
      "token": 120,
      "type": "command",
      "category": "io",
      "syntax": "MERGE \"filename\"",
      "description": "Load a BASIC program from disk and merge it with the current program in memory. Lines in the loaded program replace any existing lines with the same number.",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "description": "Name of the file to merge"
        }
      ],
      "example": "MERGE \"LIBRARY\" : REM ADD SUBROUTINES TO PROGRAM"
    },
    {
      "keyword": "RENUMBER",
      "prefix": 100,
      "token": 121,
      "type": "command",
      "category": "editor",
      "syntax": "RENUMBER [start [, step]]",
      "description": "Renumber all BASIC program lines and update all GOTO, GOSUB, and THEN references automatically.",
      "parameters": [
        {
          "name": "start",
          "type": "integer",
          "description": "New starting line number (default: 10)",
          "optional": true
        },
        {
          "name": "step",
          "type": "integer",
          "description": "Line number increment (default: 10)",
          "optional": true
        }
      ],
      "example": "RENUMBER 100, 10 : REM START AT 100, STEP 10\nRENUMBER : REM USE DEFAULTS"
    },
    {
      "keyword": "MEM",
      "prefix": 100,
      "token": 122,
      "type": "function",
      "category": "system",
      "syntax": "MEM",
      "description": "Return the amount of free BASIC memory in bytes.",
      "example": "PRINT \"FREE:\"; MEM; \" BYTES\""
    },
    {
      "keyword": "DETECT",
      "prefix": 100,
      "token": 123,
      "type": "function",
      "category": "graphics",
      "syntax": "DETECT(sprite)",
      "description": "Check if the given sprite has collided with the background (non-sprite graphics). Returns non-zero if a collision has occurred.",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "Sprite number to check for background collision"
        }
      ],
      "example": "IF DETECT(0) THEN PRINT \"HIT BACKGROUND!\""
    },
    {
      "keyword": "CHECK",
      "prefix": 100,
      "token": 124,
      "type": "function",
      "category": "graphics",
      "syntax": "CHECK(sprite1, sprite2)",
      "description": "Check if two specific sprites are colliding with each other. Returns non-zero if they are overlapping.",
      "parameters": [
        {
          "name": "sprite1",
          "type": "integer",
          "range": "0-7",
          "description": "First sprite number"
        },
        {
          "name": "sprite2",
          "type": "integer",
          "range": "0-7",
          "description": "Second sprite number"
        }
      ],
      "example": "IF CHECK(0, 1) THEN PRINT \"SPRITE 0 AND 1 COLLIDED!\""
    },
    {
      "keyword": "DISPLAY",
      "prefix": 100,
      "token": 125,
      "type": "command",
      "category": "screen",
      "syntax": "DISPLAY mode",
      "description": "Enable or disable the screen display.",
      "parameters": [
        {
          "name": "mode",
          "type": "integer",
          "range": "0-1",
          "description": "0=disable display (blank screen), 1=enable display"
        }
      ],
      "example": "DISPLAY 0 : REM BLANK SCREEN FOR SMOOTH UPDATE\nMOVE 1024, 1025, 999 : REM UPDATE SCREEN\nDISPLAY 1 : REM SHOW RESULT"
    },
    {
      "keyword": "ERR",
      "prefix": 100,
      "token": 126,
      "type": "function",
      "category": "system",
      "syntax": "ERR",
      "description": "Return the number of the last BASIC error that triggered the ON ERROR handler.",
      "example": "ON ERROR 9000\n...\n9000 PRINT \"ERROR CODE:\"; ERR : RESUME"
    },
    {
      "keyword": "OUT",
      "prefix": 100,
      "token": 127,
      "type": "command",
      "category": "io",
      "syntax": "OUT port, value",
      "description": "Write a byte value to a hardware I/O port address.",
      "parameters": [
        {
          "name": "port",
          "type": "integer",
          "range": "0-65535",
          "description": "I/O port address"
        },
        {
          "name": "value",
          "type": "integer",
          "range": "0-255",
          "description": "Byte value to write"
        }
      ],
      "example": "OUT 53280, 0 : REM SET BORDER TO BLACK"
    }
  ]
}
