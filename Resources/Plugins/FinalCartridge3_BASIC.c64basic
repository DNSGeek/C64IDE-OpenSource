{
  "name": "Final Cartridge III BASIC",
  "version": "1988-12",
  "author": "Thomas Knox",
  "description": "BASIC extensions provided by the Final Cartridge III for the Commodore 64. Adds 29 commands to Commodore BASIC 2.0 as single-byte tokens $CC-$E8, plus hexadecimal literals with a $ prefix in numeric expressions. Requires the cartridge to be present; the commands are supplied by cartridge ROM, not by a loadable runtime.",
  "url": "https://github.com/mist64/final_cartridge",
  "extendsBasicV2": true,
  "loadAddress": 8193,
  "requiresSYSStub": false,
  "tokenPrefixes": [],
  "keywords": [
    {
      "keyword": "OFF",
      "token": 204,
      "type": "command",
      "category": "system",
      "syntax": "OFF",
      "description": "Disables the BASIC extensions and restores the standard BASIC vectors. The rest of the cartridge (fast loader, freezer, monitor) stays active. Also used as an argument keyword by BAR and TRACE."
    },
    {
      "keyword": "AUTO",
      "token": 205,
      "type": "command",
      "category": "editor",
      "syntax": "AUTO [start] [,increment]",
      "description": "Enables automatic line numbering during program entry. After a line is entered with RETURN, the next line number is generated by adding the increment. With no arguments the start line is 100 and the increment is 10.",
      "parameters": [
        {
          "name": "start",
          "type": "integer",
          "range": "0-63999",
          "optional": true,
          "description": "Default 100"
        },
        {
          "name": "increment",
          "type": "integer",
          "range": "1-63999",
          "optional": true,
          "description": "Default 10"
        }
      ],
      "example": "AUTO\nAUTO 1000,5"
    },
    {
      "keyword": "DEL",
      "token": 206,
      "type": "command",
      "category": "editor",
      "syntax": "DEL range",
      "description": "Deletes a range of lines from the BASIC program in memory. A range is required; DEL with no argument is a syntax error.",
      "parameters": [
        {
          "name": "range",
          "type": "string",
          "description": "first-last, first-, -last, or a single line number"
        }
      ],
      "example": "DEL 100\nDEL 240-350\nDEL -100\nDEL 500-"
    },
    {
      "keyword": "RENUM",
      "token": 207,
      "type": "command",
      "category": "editor",
      "syntax": "RENUM [new] [,increment] [,range]",
      "description": "Renumbers the BASIC program, rewriting line number references in GOTO, GOSUB, THEN and similar targets. With no arguments the new start line is 100 and the increment is 10. The optional range limits renumbering to part of the program.",
      "parameters": [
        {
          "name": "new",
          "type": "integer",
          "range": "0-63999",
          "optional": true,
          "description": "Default 100"
        },
        {
          "name": "increment",
          "type": "integer",
          "range": "1-63999",
          "optional": true,
          "description": "Default 10"
        },
        {
          "name": "range",
          "type": "string",
          "optional": true,
          "description": "Line range: first-last, first-, -last, or a single line number"
        }
      ],
      "example": "RENUM\nRENUM 1000,10\nRENUM 500,5,200-400"
    },
    {
      "keyword": "HELP",
      "token": 208,
      "type": "command",
      "category": "system",
      "syntax": "HELP",
      "description": "Lists the BASIC line on which the last error occurred, leaving the cursor at the point in the line where the error was detected, ready for editing."
    },
    {
      "keyword": "FIND",
      "token": 209,
      "type": "command",
      "category": "editor",
      "syntax": "FIND \"string\" [,range]\nFIND text [,range]",
      "description": "Searches the BASIC program for a string and lists every line containing it. A quoted argument searches the literal text; an unquoted argument is tokenized first, so keywords are matched in their tokenized form.",
      "parameters": [
        {
          "name": "string",
          "type": "string",
          "description": "Quoted for a literal match, unquoted to match tokenized keywords"
        },
        {
          "name": "range",
          "type": "string",
          "optional": true,
          "description": "Line range: first-last, first-, -last, or a single line number"
        }
      ],
      "example": "FIND \"HELLO\"\nFIND PRINT\nFIND \"X\",100-500"
    },
    {
      "keyword": "OLD",
      "token": 210,
      "type": "command",
      "category": "editor",
      "syntax": "OLD",
      "description": "Recovers a BASIC program lost to NEW or to a reset, by restoring the start-of-program byte and relinking the line pointers."
    },
    {
      "keyword": "DLOAD",
      "token": 211,
      "type": "command",
      "category": "io",
      "syntax": "DLOAD [\"filename\"]",
      "description": "Loads a program from disk. The device number is whatever DOS last selected, not a parameter here.",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "optional": true,
          "description": "If omitted, defaults to \":*\", the first program on the disk"
        }
      ],
      "example": "DLOAD \"GAME\"\nDLOAD"
    },
    {
      "keyword": "DVERIFY",
      "token": 212,
      "type": "command",
      "category": "io",
      "syntax": "DVERIFY [\"filename\"]",
      "description": "Compares a program on disk against the program in memory.",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "optional": true,
          "description": "If omitted, defaults to \":*\", the first program on the disk"
        }
      ],
      "example": "DVERIFY \"GAME\""
    },
    {
      "keyword": "DSAVE",
      "token": 213,
      "type": "command",
      "category": "io",
      "syntax": "DSAVE \"filename\"",
      "description": "Saves the BASIC program in memory to disk.",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "description": "An empty name is accepted by the parser but will be rejected by the drive"
        }
      ],
      "example": "DSAVE \"GAME\""
    },
    {
      "keyword": "APPEND",
      "token": 214,
      "type": "command",
      "category": "io",
      "syntax": "APPEND \"filename\" [,device]",
      "description": "Appends a program from disk to the program already in memory, using the standard LOAD-style parameter list. The load address in the file is ignored. Line numbers are not checked; use ORDER afterwards if the appended lines are out of sequence.",
      "parameters": [
        {
          "name": "filename",
          "type": "string"
        },
        {
          "name": "device",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ],
      "example": "APPEND \"LIBRARY\",8"
    },
    {
      "keyword": "DAPPEND",
      "token": 215,
      "type": "command",
      "category": "io",
      "syntax": "DAPPEND [\"filename\"]",
      "description": "Appends a program from disk to the program already in memory. Same operation as APPEND, but takes only a filename and uses the device DOS last selected.",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "optional": true,
          "description": "If omitted, defaults to \":*\", the first program on the disk"
        }
      ],
      "example": "DAPPEND \"LIBRARY\""
    },
    {
      "keyword": "DOS",
      "token": 216,
      "type": "command",
      "category": "io",
      "syntax": "DOS [\"command\"]",
      "description": "Sends a command to the disk drive. With no argument it reads and prints the drive status channel. DOS \"$\" prints the directory. DOS \"8\" and DOS \"9\" select the device used by the other disk commands; only 8 and 9 are accepted.",
      "parameters": [
        {
          "name": "command",
          "type": "string",
          "optional": true,
          "description": "A drive command, \"$\" for a directory, or \"8\"/\"9\" to select the device"
        }
      ],
      "example": "DOS\nDOS \"$\"\nDOS \"9\"\nDOS \"S0:OLDFILE\""
    },
    {
      "keyword": "KILL",
      "token": 217,
      "type": "command",
      "category": "system",
      "syntax": "KILL",
      "description": "Disables the entire cartridge and warm-starts BASIC, leaving the machine in an unexpanded state. Used for software that is incompatible with the cartridge. Only a reset brings it back."
    },
    {
      "keyword": "MON",
      "token": 218,
      "type": "command",
      "category": "system",
      "syntax": "MON",
      "description": "Enters the machine language monitor. The monitor lives in cartridge ROM and does not consume user RAM."
    },
    {
      "keyword": "PDIR",
      "token": 219,
      "type": "command",
      "category": "io",
      "syntax": "PDIR [,secondary]",
      "description": "Sends the disk directory to a printer on device 4.",
      "parameters": [
        {
          "name": "secondary",
          "type": "integer",
          "range": "0-128",
          "optional": true,
          "description": "Secondary address for the printer. Omitted or out of range selects the default"
        }
      ],
      "example": "PDIR\nPDIR ,7"
    },
    {
      "keyword": "PLIST",
      "token": 220,
      "type": "command",
      "category": "io",
      "syntax": "PLIST [,secondary]",
      "description": "Sends a listing of the whole BASIC program to a printer on device 4. Unlike LIST it takes no line range.",
      "parameters": [
        {
          "name": "secondary",
          "type": "integer",
          "range": "0-128",
          "optional": true,
          "description": "Secondary address for the printer. Omitted or out of range selects the default"
        }
      ],
      "example": "PLIST\nPLIST ,7"
    },
    {
      "keyword": "BAR",
      "token": 221,
      "type": "command",
      "category": "system",
      "syntax": "BAR [OFF]",
      "description": "Enables or disables the Desktop pull-down menu bar in BASIC. BAR alone, or with any argument other than OFF, enables it.",
      "parameters": [
        {
          "name": "OFF",
          "optional": true,
          "description": "Tokenized as the OFF keyword ($CC), not as text"
        }
      ],
      "example": "BAR\nBAR OFF"
    },
    {
      "keyword": "DESKTOP",
      "token": 222,
      "type": "command",
      "category": "system",
      "syntax": "DESKTOP",
      "description": "Starts the Desktop windowing environment. Prompts \"ARE YOU SURE (Y/N)?\" first, since the BASIC program in memory is lost."
    },
    {
      "keyword": "DUMP",
      "token": 223,
      "type": "command",
      "category": "memory",
      "syntax": "DUMP",
      "description": "Lists every simple BASIC variable with its current value. Arrays are listed by ARRAY instead."
    },
    {
      "keyword": "ARRAY",
      "token": 224,
      "type": "command",
      "category": "memory",
      "syntax": "ARRAY",
      "description": "Lists every BASIC array with its dimensions."
    },
    {
      "keyword": "MEM",
      "token": 225,
      "type": "command",
      "category": "memory",
      "syntax": "MEM",
      "description": "Displays memory usage: the size of the BASIC program, the space used by variables, and the number of bytes free."
    },
    {
      "keyword": "TRACE",
      "token": 226,
      "type": "command",
      "category": "system",
      "syntax": "TRACE [OFF]",
      "description": "Enables or disables trace mode. While tracing, each line is listed as it executes with the character at the current execution point shown in reverse video. Holding CBM pauses execution and holding CTRL slows it down. TRACE alone enables it.",
      "parameters": [
        {
          "name": "OFF",
          "optional": true,
          "description": "Tokenized as the OFF keyword ($CC), not as text"
        }
      ],
      "example": "TRACE\nTRACE OFF"
    },
    {
      "keyword": "REPLACE",
      "token": 227,
      "type": "command",
      "category": "editor",
      "syntax": "REPLACE \"old\",\"new\" [,range]",
      "description": "Replaces every occurrence of one string with another throughout the program, and lists each line it changes. Quoted arguments match literal text; unquoted arguments are tokenized first.",
      "parameters": [
        {
          "name": "old",
          "type": "string"
        },
        {
          "name": "new",
          "type": "string"
        },
        {
          "name": "range",
          "type": "string",
          "optional": true,
          "description": "Line range: first-last, first-, -last, or a single line number"
        }
      ],
      "example": "REPLACE \"COLOUR\",\"COLOR\"\nREPLACE \"X\",\"Y\",100-500"
    },
    {
      "keyword": "ORDER",
      "token": 228,
      "type": "command",
      "category": "editor",
      "syntax": "ORDER",
      "description": "Sorts the BASIC program lines into ascending line number order and relinks them. Intended for cleaning up after APPEND or DAPPEND."
    },
    {
      "keyword": "PACK",
      "token": 229,
      "type": "command",
      "category": "editor",
      "syntax": "PACK",
      "description": "Compresses the BASIC program in memory. The packed program still runs, but cannot be edited until UNPACK is used."
    },
    {
      "keyword": "UNPACK",
      "token": 230,
      "type": "command",
      "category": "editor",
      "syntax": "UNPACK",
      "description": "Decompresses a program previously compressed with PACK, restoring it to an editable listing."
    },
    {
      "keyword": "MREAD",
      "token": 231,
      "type": "command",
      "category": "memory",
      "syntax": "MREAD address",
      "description": "Copies 192 bytes from the given address into an internal buffer. Undocumented helper used by the Desktop and monitor rather than a general-purpose BASIC command.",
      "parameters": [
        {
          "name": "address",
          "type": "integer",
          "range": "0-65535"
        }
      ],
      "example": "MREAD 49152"
    },
    {
      "keyword": "MWRITE",
      "token": 232,
      "type": "command",
      "category": "memory",
      "syntax": "MWRITE address",
      "description": "Copies 192 bytes from the internal buffer to the given address. Undocumented counterpart to MREAD.",
      "parameters": [
        {
          "name": "address",
          "type": "integer",
          "range": "0-65535"
        }
      ],
      "example": "MWRITE 49152"
    }
  ]
}
