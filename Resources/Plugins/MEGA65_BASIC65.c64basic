    {
      "keyword": "INSTR",
      "token": 212,
      "type": "command",
      "category": "system",
      "syntax": "INSTR(haystack, needle [, start])",
      "description": "Locates the position of the string expression needle in the string expression haystack, and returns the index of the first occurrence, or zero if there is no match.",
      "parameters": [
        {
          "name": "haystack",
          "type": "string",
          "description": "The string to search"
        },
        {
          "name": "needle",
          "type": "string",
          "description": "The string to find in the haystack"
        },
        {
          "name": "start",
          "type": "integer",
          "description": "The position in haystack to start searching from",
          "optional": true
        }
      ]
    },
    {
      "keyword": "JOY",
      "token": 207,
      "type": "function",
      "category": "system",
      "syntax": "JOY(port)",
