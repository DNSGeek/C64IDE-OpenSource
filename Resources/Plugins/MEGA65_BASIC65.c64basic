    },
    {
      "keyword": "MEM",
      "prefix": 254,
      "token": 35,
      "type": "command",
      "category": "system",
      "syntax": "MEM mask4, mask5",
      "description": "Reserves memory in banks 4 or 5, such that the bitmap graphics system will not use it",
      "parameters": [
        {
          "name": "mask4",
          "type": "integer",
          "range": "0-255",
          "description": "A bitfield representing bank 4"
        },
        {
          "name": "mask5",
          "type": "integer",
          "range": "0-255",
          "description": "A bitfield representing bank 5"
        }
      ]
    },
    {
      "keyword": "MERGE",
      "token": 230,
      "type": "command",
      "category": "io",
      "syntax": "MERGE filename [,D drive] [,U unit]",
      "description": "Loads a BASIC program file from disk and appends it to the program in memory. The load address stored in the first two bytes of the file is ignored. The loaded program does not replace a program in memory (as DLOAD does), but is appended. After loading, the program is re-linked and ready to run or edit. It is the user's responsibility to ensure there are no line number conflicts — the first line number of the merged program must be greater than the last line number of the program in memory. MERGE can only be used in direct mode.",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "description": "The name of a file. Either a quoted string such as \"DATA\", or a string expression in brackets such as (FI$)"
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true,
          "description": "Drive # in dual drive disk units. Defaults to 0 and can be omitted on single drive units such as the 1541, 1571, or 1581."
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true,
          "description": "Device number on the IEC bus. Defaults to 8. If a variable is used, it must be placed in brackets."
        }
      ],
      "example": "DLOAD \"MAIN PROGRAM\"\nMERGE \"LIBRARY\""
    },
    {
      "keyword": "MKDIR",
      "prefix": 254,
      "token": 81,
      "type": "command",
      "category": "io",
      "syntax": "MKDIR dirname ,L size [,U unit]",
      "description": "Makes (creates) a subdirectory on a floppy or D81 disk image.",
      "example": "MKDIR \"SUBDIR\", L5",
      "parameters": [
        {
          "name": "dirname",
          "type": "string"
        },
        {
          "name": "size",
          "type": "integer",
          "range": "3-38",
          "description": "specifies the number of tracks to be reserved for the subdirectory, with one track = 40 sectors at 256 bytes."
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "MOD",
      "prefix": 206,
      "token": 11,
      "type": "function",
      "category": "system",
      "syntax": "MOD(dividend, divisor)",
      "description": "The remainder of a division operation.",
      "example": "FOR I = 0 TO 8 : PRINT MOD(I, 4); : NEXT I\n0 1 2 3 0 1 2 3 0",
      "parameters": [
        {
          "name": "dividend",
          "type": "integer"
        },
        {
          "name": "divisor",
          "type": "integer"
        }
      ]
    },
    {
      "keyword": "MONITOR",
      "token": 250,
      "type": "command",
