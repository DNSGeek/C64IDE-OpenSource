        {
          "name": "filename",
          "type": "string",
          "description": "The file to delete"
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        },
        {
          "name": "R",
          "description": "Will recover a previously erased file",
          "optional": true
        }
      ]
    },
    {
      "keyword": "SCREEN",
      "prefix": 254,
      "token": 46,
      "type": "command",
      "category": "screen",
      "syntax": "SCREEN [screen,] width, height, depth",
      "description": "Manages a graphics screen",
      "example": "SCREEN 320, 200, 2\nSCREEN CLR\nSCREEN OPEN [screen]\nSCREEN CLOSE [screen]",
      "parameters": [
        {
          "name": "screen",
          "type": "integer",
          "range": "0-3",
          "optional": true,
          "description": "The screen to use"
        },
        {
          "name": "width",
          "type": "integer",
          "range": "320,640",
          "description": "The screen width to use"
        },
        {
          "name": "height",
          "type": "integer",
          "range": "200,400",
          "description": "The screen height to use"
        },
        {
          "name": "depth",
          "type": "integer",
          "range": "0-8",
          "description": "The color bit depth to use"
        }
      ]
    },
    {
      "keyword": "SET",
      "prefix": 254,
      "token": 45,
      "type": "command",
      "category": "io",
      "syntax": "SET parameter value",
      "description": "Redefines the default unit for disk access",
      "example": "SET DEF unit\nSET DISK old TO new\nSET VERIFY <ON | OFF"
    },
    {
      "keyword": "SLEEP",
      "prefix": 254,
      "token": 11,
      "type": "command",
      "category": "system",
      "syntax": "SLEEP seconds",
      "description": "Pauses program execution for the given duration",
      "example": "SLEEP 0.0005\nSLEEP 10\nSLEEP 0.01",
      "parameters": [
        {
          "name": "seconds",
          "type": "float",
          "description": "The number of seconds to wait"
        }
      ]
    },
    {
      "keyword": "SOUND",
      "token": 218,
      "type": "command",
      "category": "sound",
      "syntax": "SOUND voice, freq, dur [{, dir, min, sweep, wave, pulse}]",
      "description": "Plays a sound effect",
      "example": "SOUND 3, 4000, 120, 2, 2000, 400, 1\nSOUND CLR",
      "parameters": [
        {
          "name": "voice",
          "type": "integer",
          "range": "1-6",
          "description": "The voice to use for the sound"
        },
        {
          "name": "freq",
          "type": "integer",
          "range": "0-65535",
          "description": "The frequency to play"
        },
        {
          "name": "dur",
          "type": "integer",
          "range": "0-32767",
          "description": "The duration to play the sound, in jiffies"
        },
        {
          "name": "dir",
          "type": "integer",
          "range": "0-2",
          "description": "direction 0=up, 1=down, 2=oscillate",
          "optional": true
        },
        {
          "name": "min",
          "type": "integer",
          "range": "0-65535",
          "description": "The minimum freq to play",
          "optional": true
        },
        {
          "name": "sweep",
          "type": "integer",
          "range": "0-65535",
          "description": "The sweep range",
          "optional": true
        },
        {
          "name": "wave",
          "type": "integer",
          "range": "0-3",
          "description": "The waveform to use: 0=triangle, 1=sawtooth, 2=square, 3=noise",
          "optional": true
        },
        {
          "name": "pulse",
          "type": "integer",
          "range": "0-4095",
          "description": "The pulse width to use",
          "optional": true
        }
      ]
    },
    {
      "keyword": "SPEED",
      "prefix": 254,
      "token": 38,
      "type": "command",
      "category": "system",
      "syntax": "SPEED [speed]",
      "description": "Sets the CPU clock speed",
      "parameters": [
        {
          "name": "speed",
          "type": "integer",
          "range": "1,3",
          "description": "1=1MHz, 3=3.5MHz, no argument=40MHz",
