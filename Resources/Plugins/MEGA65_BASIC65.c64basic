    },
    {
      "keyword": "VSYNC",
      "prefix": 254,
      "token": 84,
      "type": "command",
      "category": "graphics",
      "syntax": "VSYNC raster_line",
      "description": "Waits until the raster_line is active"
    },
    {
      "keyword": "WHILE",
      "token": 253,
      "category": "flow",
      "type": "command",
      "description": "Define the exit of a DO ... LOOP",
