    {
      "keyword": "ERR$",
      "token": 211,
      "type": "function",
      "category": "system",
      "syntax": "ERR$(number)",
      "description": "Returns the string description of a given BASIC error number. Typically used in a TRAP routine, where the error number is taken from the reserved variable ER. A BASIC error number out of range (1-44) will produce an OK.",
      "parameters": [
        {
          "name": "number",
          "type": "integer",
          "range": "1-44",
          "description": "BASIC error number"
        }
      ],
      "example": "10 TRAP 100\n20 PRINT SQR(-1) : REM PROVOKE ERROR\n30 PRINT \"AT LINE 30\" : REM HERE TO RESUME\n40 END\n100 IF ER > 0 THEN PRINT ERR$(ER); \" ERROR\";\n110 PRINT \" IN LINE\"; EL\n120 RESUME NEXT : REM RESUME AFTER ERROR"
    },
    {
      "keyword": "EXIT",
      "token": 237,
      "type": "command",
