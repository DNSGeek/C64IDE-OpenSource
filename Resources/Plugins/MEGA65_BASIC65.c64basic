          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "UNTIL",
      "token": 252,
      "type": "command",
      "category": "flow",
      "description": "Set the exit criteria for a DO ... LOOP",
      "example": "10 DO\n20 GET A$\n30 LOOP UNTIL A$= \"Y\" OR A$ = \"N\""
    },
    {
      "keyword": "USING",
      "token": 251,
      "type": "command",
      "category": "system",
