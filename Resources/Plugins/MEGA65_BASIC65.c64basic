      "parameters": [
        {
          "name": "port",
          "type": "integer",
          "range": "0-3",
          "description": "A port value of 3 will return the merged state of both joystick ports"
        }
      ]
    },
    {
      "keyword": "KEY",
      "token": 249,
      "type": "command",
      "category": "system",
      "description": "Manages the function key macros in the BASIC editor.",
