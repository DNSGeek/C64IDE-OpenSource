          "name": "count",
          "type": "integer",
          "description": "The number of times to repeat the string"
        }
      ]
    },
    {
      "keyword": "RREG",
      "prefix": 254,
      "token": 9,
      "type": "command",
      "category": "system",
      "syntax": "RREG [{areg, xreg, yreg, zreg, sreg}]",
      "description": "Reads the values that were in the CPU registers after a SYS call, into the specified variables",
      "example": "10 POKE $1800, $18, $8A, $65, $06, $60\n20 REM CLC TXA ADC 06 RTS\n30 SYS $1800, 77, 11\n40 RREG AC, X, Y, Z, S\n50 PRINT \"REGISTER:\"; AC; X; Y; Z; S",
      "parameters": [
        {
          "name": "areg",
          "description": "The variable that the value of the a register will be placed into"
        },
        {
          "name": "xreg",
          "description": "The variable that the value of the x register will be placed into"
        },
        {
          "name": "yreg",
          "description": "The variable that the value of the y register will be placed into"
        },
        {
          "name": "zreg",
          "description": "The variable that the value of the z register will be placed into"
        },
        {
          "name": "sreg",
          "description": "The variable that the value of the s register will be placed into"
        }
      ]
    },
    {
      "keyword": "RSPCOLOR",
      "prefix": 206,
      "token": 7,
      "type": "function",
      "category": "graphics",
      "syntax": "RSPCOLOR(n)",
      "description": "Returns the colour setting of a multi-colour sprite colour.",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "1-2",
          "description": "The sprite multi-color number to get"
        }
      ]
    },
    {
      "keyword": "RSPEED",
      "prefix": 206,
      "token": 14,
      "type": "function",
      "category": "system",
      "syntax": "RSPEED(0)",
      "description": "Returns the current CPU clock in MHz. 1=1MHz, 3=3.5MHz, 40=40MHz"
    },
    {
      "keyword": "RSPPOS",
      "prefix": 206,
      "token": 5,
      "type": "function",
      "category": "graphics",
      "syntax": "RSPPOS(sprite,n)",
      "description": "Read sprite position or speed",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "The sprite to read"
        },
        {
          "name": "n",
          "type": "integer",
          "range": "0-2",
          "description": "The parameter to get. 0=X, 1=Y, 2=Speed"
        }
      ]
    },
    {
      "keyword": "RSPRITE",
      "prefix": 206,
      "token": 6,
      "type": "function",
      "category": "graphics",
      "syntax": "RSPRITE(sprite,n)",
      "description": "Read sprite parameters",
      "parameters": [
        {
          "name": "sprite",
          "type": "integer",
          "range": "0-7",
          "description": "The sprite to read"
        },
        {
          "name": "n",
          "type": "integer",
          "range": "0-5",
          "description": "The parameter to return: 0=on, 1=fg color, 2=bg priority, 3=x-expanded, 4=y-expanded, 5=multi-color"
        }
      ]
    },
    {
      "keyword": "RSPRSYS",
      "prefix": 206,
      "token": 23,
      "type": "function",
      "category": "graphics",
      "syntax": "RSPRSYS(0)",
      "description": "Returns sprite high resolution mode, 0=disabled, 1=enabled"
    },
    {
      "keyword": "RWINDOW",
      "prefix": 206,
      "token": 9,
      "type": "function",
      "category": "screen",
      "syntax": "RWINDOW(n)",
      "description": "Returns current window parameter n",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "0-3",
          "description": "0=width, 1=height, 2=columns, 3=rows"
        }
      ]
    },
    {
      "keyword": "SAVEIFF",
      "prefix": 254,
      "token": 68,
      "type": "command",
      "category": "graphics",
      "syntax": "SAVEIFF filename [,D drive] [,U unit]",
      "description": "Saves the current graphics screen to a disk file in IFF format.",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "description": "The name to save the IFF as"
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "SCNCLR",
      "token": 232,
      "type": "command",
      "category": "graphics",
      "syntax": "SCNCLR [colour]",
      "description": "Clears a text window or bitmap graphics screen.",
      "parameters": [
        {
          "name": "colour",
          "type": "integer",
          "description": "The color to fill the screen with",
          "optional": true
        }
      ]
    },
    {
      "keyword": "SCRATCH",
      "token": 242,
      "type": "command",
      "category": "io",
      "syntax": "SCRATCH filename [,D drive] [,U unit] [,R]",
