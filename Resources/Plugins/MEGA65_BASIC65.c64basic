    },
    {
      "keyword": "MOUNT",
      "prefix": 254,
      "token": 73,
      "type": "command",
      "category": "io",
      "syntax": "MOUNT filename [,U unit]",
      "description": "Mounts a disk image file of type D81 or D64 from SD card to unit 8 (default) or unit 9 (U9).",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "description": "The name of the disk image to mount"
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-9"
        }
      ]
    },
    {
      "keyword": "MOUSE",
      "prefix": 254,
      "token": 62,
      "type": "command",
      "category": "system",
      "syntax": "MOUSE ON [{, port, sprite, hotspot, pos}]",
      "description": "Enables the mouse driver and connects the mouse at the specified port with the mouse pointer sprite.",
      "example": "MOUSE ON, 1\nMOUSE OFF",
      "parameters": [
        {
          "name": "port",
          "type": "integer",
          "range": "1-2",
          "description": "Selects mouse port 1 or 2",
          "optional": true
        },
        {
          "name": "sprite",
          "type": "integer",
          "description": "The sprite number for the mouse pointer",
          "optional": true
        },
        {
          "name": "hotspot",
          "type": "integer",
          "description": "A 2 integer value representing the x, y coordinate of the click point in the sprite, e.g. 2, 4",
          "optional": true
        },
        {
          "name": "pos",
          "type": "integer",
          "description": "A 2 integer value representing the current mouse position, use last position if not specified, e.g. 2,4",
          "optional": true
        }
      ]
    },
    {
      "keyword": "MOVSPR",
      "prefix": 254,
      "token": 6,
      "type": "command",
      "category": "graphics",
      "syntax": "MOVSPR number, position [TO end-position, speed]",
      "description": "Moves a sprite to a location on screen.",
      "parameters": [
        {
          "name": "number",
          "type": "integer",
          "range": "0-7"
        },
        {
          "name": "position",
          "type": "integer",
          "description": "Each position argument consists of two 16-bit values, which specify either an absolute coordinate, a relative coordinate, an angle, or a speed."
        },
        {
          "name": "end-position",
          "type": "integer",
          "description": "Each position argument consists of two 16-bit values, which specify either an absolute coordinate, a relative coordinate, an angle, or a speed.",
          "optional": true
        },
        {
          "name": "speed",
          "type": "float",
          "range": "0.0-127.0",
          "description": "The speed of movement. Non-optional if TO end-argument is used",
          "optional": true
        }
      ],
      "example": "MOVSPR 0, 160, 100"
    },
    {
      "keyword": "OFF",
      "prefix": 254,
      "token": 36,
      "type": "command",
      "category": "system",
      "syntax": "OFF",
      "description": "Disable current interrupt or feature"
    },
    {
      "keyword": "PAINT",
      "token": 223,
      "type": "command",
      "category": "graphics",
      "syntax": "PAINT x, y, mode [, region_border_colour]",
      "description": "Bitmap graphics: performs a flood fill of an enclosed graphics area using the current pen colour.",
      "parameters": [
        {
          "name": "x",
          "type": "integer",
          "description": "The x coordinate inside the area to be painted"
        },
        {
          "name": "y",
          "type": "integer",
          "description": "The y coordinate inside the area to be painted"
        },
        {
          "name": "mode",
          "type": "integer",
          "range": "0-2",
          "description": "0: The colour of pixel (x,y) defines the colour\n1: The region border colour defines the region to be painted with the pen colour.\n2: Paint the region connected to pixel (x, y)."
        },
        {
          "name": "region_border_color",
          "type": "integer",
          "description": "the colour index for mode 1.",
          "optional": true
        }
      ]
    },
    {
      "keyword": "PALETTE",
