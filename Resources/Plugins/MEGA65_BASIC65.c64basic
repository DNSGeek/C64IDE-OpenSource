        },
        {
          "name": "right",
          "type": "integer",
          "range": "0-39 or 0-79",
          "description": "The right column"
        },
        {
          "name": "bottom",
          "type": "integer",
          "range": "0-24",
          "description": "The bottom row"
        },
        {
          "name": "clear",
          "type": "integer",
          "range": "0-1",
