{
  "name": "MEGA65 BASIC 65",
  "version": "920413",
  "author": "Thomas Knox",
  "description": "BASIC 65 for the MEGA65 personal computer. Extends Commodore BASIC 10 (C65) with additional commands for the MEGA65 hardware. Includes all BASIC 10 keywords inherited from the C128's BASIC 7.",
  "url": "https://mega65.org",
  "extendsBasicV2": true,
  "loadAddress": 8193,
  "machine": "mega65",
  "requiresSYSStub": false,
  "tokenPrefixes": [
    {
      "byte": 206,
      "description": "CE-prefix: BASIC 10 extended commands (first group)"
    },
    {
      "byte": 254,
      "description": "FE-prefix: BASIC 10 extended commands (second group)"
    },
    {
      "byte": 224,
      "description": "E0-prefix: BASIC 10 extended commands (third group)"
    }
  ],
  "keywords": [
    {
      "keyword": "<<",
      "prefix": 254,
      "token": 82,
      "type": "operator",
      "category": "system",
      "description": "Arithmetic shift left"
    },
    {
      "keyword": ">>",
      "prefix": 254,
      "token": 83,
      "type": "operator",
      "category": "system",
      "description": "Arithmetic shift right"
    },
    {
      "keyword": "APPEND",
      "prefix": 254,
      "token": 14,
      "type": "command",
      "category": "io",
      "syntax": "APPEND#channel, \"filename\" [,D drive] [,U unit]",
      "description": "Open a disk file for appending data. The file must already exist.",
      "parameters": [
        {
          "name": "#channel",
          "type": "integer",
          "range": "1-255",
          "description": "If channel between 1 and 127, line terminator is CR, otherwise it is CR LF"
        },
        {
          "name": "filename",
          "type": "string"
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "AUTO",
      "token": 220,
      "type": "command",
      "category": "editor",
      "syntax": "AUTO [step]",
      "description": "Enables or disables automatic line numbering during BASIC program entry. After submitting a new program line to the BASIC editor with RETURN, the AUTO function generates a new BASIC line number for the entry of the next line. The new number is computed by adding step to the current line number.",
      "example": "AUTO 10",
      "parameters": [
        {
          "name": "step",
          "type": "integer",
          "range": "0-255",
          "optional": true,
          "description": "The number to add between line numbers"
        }
      ]
    },
    {
      "keyword": "BACKGROUND",
      "prefix": 254,
      "token": 59,
      "type": "command",
      "category": "system",
      "description": "Sets the background colour of the screen.",
      "syntax": "BACKGROUND color",
      "example": "BACKGROUND 3",
      "parameters": [
        {
          "name": "color",
          "type": "integer",
          "range": "0-255",
          "description": "The color palette number"
        }
      ]
    },
    {
      "keyword": "BACKUP",
      "token": 246,
      "type": "command",
      "category": "io",
      "syntax": "BACKUP U source TO U target [, U unit]",
      "description": "Copies one disk to another",
      "example": "BACKUP U0 TO U9\n\nBACKUP D0 TO D1, U10",
      "parameters": [
        {
          "name": "source",
          "type": "integer",
          "range": "0-15",
          "description": "The disk or drive number"
        },
        {
          "name": "target",
          "type": "integer",
          "range": "0-15",
          "description": "The disk or drive number"
        },
        {
          "name": "unit",
          "type": "integer",
          "optional": true,
          "range": "8-11",
          "description": "The disk number"
        }
      ]
    },
    {
      "keyword": "BANK",
      "prefix": 254,
      "token": 2,
      "type": "command",
      "category": "memory",
      "syntax": "BANK n",
      "description": "Set memory bank for PEEK/POKE operations (0-255). BANK 128 = current system config.",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "0-255"
        }
      ],
      "example": "BANK 0 : POKE 1024, 65"
    },
    {
      "keyword": "BEGIN",
      "prefix": 254,
      "token": 24,
      "type": "command",
      "category": "flow",
      "description": "The beginning of a compound statement to be executed after THEN or ELSE. This overcomes the single line limitation of the standard IF ... THEN ... ELSE clause."
    },
    {
      "keyword": "BEND",
      "prefix": 254,
      "token": 25,
      "type": "command",
      "category": "flow",
      "description": "The end of a compound statement to be executed after THEN or ELSE.  This overcomes the single line limitation of the standard IF ... THEN ...  ELSE clause."
    },
    {
      "keyword": "BIT",
      "prefix": 254,
      "token": 78,
      "type": "command",
      "category": "system",
      "description": "The 'BIT' token used as the second half of compound keywords such as SETBIT and CLRBIT."
    },
    {
      "keyword": "BLOAD",
      "prefix": 254,
      "token": 17,
      "type": "command",
      "category": "io",
      "syntax": "BLOAD \"filename\" [,U unit] [,D drive]",
      "description": "Load a binary file to its original address",
      "example": "BLOAD \"SPRITES.BIN\"",
      "parameters": [
        {
          "name": "filename",
          "type": "string"
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        }
      ]
    },
    {
      "keyword": "BOOT",
      "prefix": 254,
      "token": 27,
      "type": "command",
      "category": "system",
      "syntax": "BOOT [filename] [,B bank] [,P address] [,D drive] [,U unit]",
      "description": "Loads and runs a program or boot sector from a disk.",
      "example": "BOOT\n\nBOOT SYS\n\nBOOT (FI$) B(BA%), P(PA), U(UN%)",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "optional": true
        },
        {
          "name": "bank",
          "type": "integer",
          "range": "0-255",
          "optional": true
        },
        {
          "name": "address",
          "type": "integer",
          "range": "0-65535",
          "optional": true
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "BORDER",
      "prefix": 254,
      "token": 60,
      "type": "command",
      "category": "screen",
      "description": "Sets the border colour of the screen.",
      "syntax": "BORDER color",
      "parameters": [
        {
          "name": "color",
          "type": "integer",
          "range": "0-255"
        }
      ],
      "example": "BORDER 4"
    },
    {
      "keyword": "BOX",
      "token": 225,
      "type": "command",
      "category": "graphics",
      "syntax": "BOX x0,y0, x1,y1 [, x2,y2] [, x3,y3] [, solid]",
      "description": "Bitmap graphics: draws a box.",
      "example": "BOX 0, 0, 160, 0, 160, 80, 0, 80",
      "parameters": [
        {
          "name": "x0",
          "type": "integer"
        },
        {
          "name": "y0",
          "type": "integer"
        },
        {
          "name": "x1",
          "type": "integer"
        },
        {
          "name": "y1",
          "type": "integer"
        },
        {
          "name": "x2",
          "type": "integer",
          "optional": true
        },
        {
          "name": "y2",
          "type": "integer",
          "optional": true
        },
        {
          "name": "x3",
          "type": "integer",
          "optional": true
        },
        {
          "name": "y3",
          "type": "integer",
          "optional": true
        },
        {
          "name": "solid",
          "type": "integer",
          "range": "0-1",
          "optional": true
        }
      ]
    },
    {
      "keyword": "BSAVE",
      "prefix": 254,
      "token": 16,
      "type": "command",
      "category": "io",
      "syntax": "BSAVE \"filename\", P start TO P end [,B bank] [,R] [,D drive] [,U unit]",
      "description": "Save a block of memory to disk as a binary file",
      "example": "BSAVE \"SCREEN\", 2048, 3047",
      "parameters": [
        {
          "name": "filename",
          "type": "string"
        },
        {
          "name": "start",
          "type": "integer",
          "range": "0-65535"
        },
        {
          "name": "end",
          "type": "integer",
          "range": "0-65535"
        },
        {
          "name": "bank",
          "type": "integer",
          "range": "0-255",
          "optional": true
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "BUMP",
      "prefix": 206,
      "token": 3,
      "type": "function",
      "category": "graphics",
      "syntax": "BUMP(type)",
      "description": "A bitfield of sprites currently colliding with other sprites or screen data.",
      "example": "10 S% = BUMP(1) : REM SPRITE <-> SPRITE COLLISION\n20 IF (S% AND 6) = 6 THEN PRINT \"SPRITE 1 & 2 COLLISION\"",
      "parameters": [
        {
          "name": "type",
          "type": "integer",
          "range": "1-2"
        }
      ]
    },
    {
      "keyword": "BVERIFY",
      "prefix": 254,
      "token": 40,
      "type": "command",
      "category": "io",
      "syntax": "BVERIFY filename [,P address] [,B bank] [,D drive] [,U unit]",
      "description": "Compares a memory range to a file of type PRG.",
      "example": "BVERIFY \"ML DATA\", P 32768, B0, U9",
      "parameters": [
        {
          "name": "filename",
          "type": "string"
        },
        {
          "name": "address",
          "type": "integer",
          "range": "0-65535",
          "optional": true
        },
        {
          "name": "bank",
          "type": "integer",
          "range": "0-255",
          "optional": true
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "CATALOG",
      "prefix": 254,
      "token": 12,
      "type": "command",
      "category": "io",
      "syntax": "CATALOG [filepattern] [,W] [,R] [,D drive] [,U unit]",
      "description": "Prints a file catalog/directory of the specified disk.",
      "parameters": [
        {
          "name": "filepattern",
          "type": "string",
          "optional": true
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "CHANGE",
      "prefix": 254,
      "token": 44,
      "type": "command",
      "category": "editor",
      "syntax": "CHANGE oldstr TO newstr [, line_range]",
      "description": "Search and replace a string in the program listing",
      "example": "CHANGE \"XX$\" TO \"UU$\", 2000-2700",
      "parameters": [
        {
          "name": "oldstr",
          "type": "string"
        },
        {
          "name": "newstr",
          "type": "string"
        },
        {
          "name": "line_range",
          "type": "string",
          "description": "Line range to search, e.g. 10-50"
        }
      ]
    },
    {
      "keyword": "CHAR",
      "token": 224,
      "category": "system",
      "type": "command",
      "syntax": "CHAR column, row, height, width, direction, string [, address]",
      "description": "displays text on a graphic screen.",
      "parameters": [
        {
          "name": "column",
          "type": "integer",
          "range": "0-39 or 0-79",
          "description": "Horizontal start position of the output"
        },
        {
          "name": "row",
          "type": "integer",
          "range": "0-24",
          "description": "Vertical start position of the output"
        },
        {
          "name": "height",
          "type": "integer",
          "description": "Vertical scaling factor for the text"
        },
        {
          "name": "width",
          "type": "integer",
          "description": "Horizontal scaling factor for the text"
        },
        {
          "name": "direction",
          "type": "integer",
          "range": "1,2,4,8",
          "description": "The printing direction: 1=up, 2=right, 4=down, 8=left"
        },
        {
          "name": "string",
          "type": "string",
          "description": "The text to display"
        },
        {
          "name": "address",
          "type": "integer",
          "range": "0-65535",
          "optional": true,
          "description": "The address of the character set to use"
        }
      ]
    },
    {
      "keyword": "CHARDEF",
      "prefix": 224,
      "token": 150,
      "type": "command",
      "category": "screen",
      "syntax": "CHARDEF index, bit-matrix",
      "description": "Changes the appearance of a character.",
      "example": "CHARDEF 1, $FF, $81, $81, $81, $81, $81, $81, $81, $FF : REM CHANGE 'A' TO A RECTANGLE",
      "parameters": [
        {
          "name": "index",
          "type": "integer",
          "range": "0-511"
        },
        {
          "name": "bit-matrix",
          "type": "string",
          "description": "A set of 8 byte values"
        }
      ]
    },
    {
      "keyword": "CHDIR",
      "prefix": 254,
      "token": 75,
      "type": "command",
      "category": "io",
      "description": "Changes the current working directory.",
      "syntax": "CHDIR dirname [,U unit]",
      "parameters": [
        {
          "name": "dirname",
          "type": "string"
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11"
        }
      ]
    },
    {
      "keyword": "CIRCLE",
      "token": 226,
      "type": "function",
      "category": "graphics",
      "syntax": "CIRCLE xc, yc, radius [, flags, start, stop]",
      "description": "Bitmap graphics: draws a circle. This is a special case of ELLIPSE, using the same value for horizontal and vertical radius.",
      "parameters": [
        {
          "name": "xc",
          "type": "integer"
        },
        {
          "name": "yc",
          "type": "integer"
        },
        {
          "name": "radius",
          "type": "integer"
        },
        {
          "name": "flags",
          "type": "integer",
          "range": "0-7",
          "optional": true
        },
        {
          "name": "start",
          "type": "integer",
          "range": "0-360",
          "optional": true
        },
        {
          "name": "stop",
          "type": "integer",
          "range": "0-360",
          "optional": true,
          "description": "The end angle for partial circle drawing"
        }
      ]
    },
    {
      "keyword": "COLLECT",
      "token": 243,
      "type": "command",
      "category": "io",
      "syntax": "COLLECT [,D drive] [,U unit]",
      "description": "Rebuilds the Block Availability Map (BAM) of a disk, deleting splat files (files which have been opened, but not properly closed) and marking unused blocks as free.",
      "parameters": [
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "COLLISION",
      "prefix": 254,
      "token": 23,
      "type": "command",
      "category": "graphics",
      "syntax": "COLLISION type [, line_number]",
      "description": "Enables or disables a user-programmed interrupt handler for sprite collision.",
      "parameters": [
        {
          "name": "type",
          "type": "integer",
          "range": "0-7"
        },
        {
          "name": "line_number",
          "type": "integer",
          "optional": true
        }
      ]
    },
    {
      "keyword": "COLOR",
      "token": 231,
      "type": "command",
      "category": "screen",
      "syntax": "COLOR color",
      "description": "Sets the foreground text colour for subsequent PRINT commands.",
      "parameters": [
        {
          "name": "color",
          "type": "integer",
          "range": "0-255"
        }
      ]
    },
    {
      "keyword": "CONCAT",
      "prefix": 254,
      "token": 19,
      "type": "command",
      "category": "io",
      "syntax": "CONCAT appendfile [,D drive] TO targetfile [,D drive] [,U unit]",
      "description": "Appends (concatenates) the contents of the appendfile to the target-file. Afterwards, targetfile contains the contents of both files, while appendfile remains unchanged.",
      "example": "CONCAT \"NEW DATA\" TO \"ARCHIVE\", U9\n\nCONCAT \"ADDRESS\", D0 TO \"ADDRESS BOOK\", D1",
      "parameters": [
        {
          "name": "appendfile",
          "type": "string"
        },
        {
          "name": "targetfile",
          "type": "string"
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "COPY",
      "token": 244,
      "category": "io",
      "type": "command",
      "syntax": "COPY source [,D drive] [,U unit] TO [target] [,D drive] [,U unit]",
      "description": "Copies a file to another file, or one or more files from one disk to another.",
      "example": "COPY \"CODES\" TO \"BACKUP\"",
      "parameters": [
        {
          "name": "source",
          "type": "string"
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        },
        {
          "name": "target",
          "type": "string",
          "optional": true
        }
      ]
    },
    {
      "keyword": "CURSOR",
      "prefix": 254,
      "token": 65,
      "type": "command",
      "category": "screen",
      "syntax": "CURSOR column, row",
      "description": "Moves the text cursor to the specified position on the current text screen.",
      "example": "CURSOR 1,2\nCURSOR OFF\nCURSOR ,5\nCURSOR ON",
      "parameters": [
        {
          "name": "column",
          "type": "integer"
        },
        {
          "name": "row",
          "type": "integer"
        }
      ]
    },
    {
      "keyword": "CUT",
      "token": 228,
      "type": "function",
      "category": "graphics",
      "syntax": "CUT x, y, width, height",
      "description": "Bitmap graphics: copies the content of the specified rectangle with upper left position x, y and the width and height to a buffer, and fills the region afterwards with the colour of the currently selected pen.",
      "example": "CUT 140, 80, 40, 40",
      "parameters": [
        {
          "name": "x",
          "type": "integer"
        },
        {
          "name": "y",
          "type": "integer"
        },
        {
          "name": "width",
          "type": "integer"
        },
        {
          "name": "height",
          "type": "integer"
        }
      ]
    },
    {
      "keyword": "DCLEAR",
      "prefix": 254,
      "token": 21,
      "type": "command",
      "category": "io",
      "syntax": "DCLEAR [,D drive] [,U unit]",
      "description": "Initialize disk drive — clears all channels and rereads the BAM",
      "example": "DCLEAR\nDCLEAR U9\nDCLEAR D0, U9",
      "parameters": [
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "DCLOSE",
      "prefix": 254,
      "token": 15,
      "type": "command",
      "category": "io",
      "syntax": "DCLOSE [,D drive] [,U unit]",
      "description": "Closes a single file or all files for the specified unit.",
      "example": "DCLOSE#2\nDCLOSE U9",
      "parameters": [
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "DEC",
      "token": 209,
      "type": "function",
      "category": "system",
      "syntax": "DEC(string)",
      "description": "The decimal value of a hexadecimal string.",
      "example": "PRINT DEC(\"D000\")\n53248"
    },
    {
      "keyword": "DECBIN",
      "prefix": 206,
      "token": 17,
      "type": "function",
      "category": "system",
      "description": "The decimal value of a binary string.",
      "syntax": "DECBIN(string_expression)",
      "example": "PRINT DECBIN(\"1101000000000000\")\n53248",
      "parameters": [
        {
          "name": "string_expression",
          "type": "string"
        }
      ]
    },
    {
      "keyword": "DELETE",
      "token": 247,
      "type": "function",
      "category": "editor",
      "syntax": "DELETE [line_range]\nDELETE filename [,D drive] [,U unit] [,R]",
      "description": "The first form deletes a range of lines from the BASIC program. The second form deletes one or more files from a disk.",
      "example": "DELETE 100\nDELETE 240-350\nDELETE \"DRM\", U9",
      "parameters": [
        {
          "name": "line_range",
          "description": "A single line number or a range of line numbers",
          "optional": true
        },
        {
          "name": "filename",
          "type": "string"
        },
        {
          "name": "drive",
          "type": "integer",
          "range": "0-15",
          "optional": true
        },
        {
          "name": "unit",
          "type": "integer",
          "range": "8-11",
          "optional": true
        }
      ]
    },
    {
      "keyword": "DIR",
      "token": 238,
      "type": "command",
      "category": "io",
      "syntax": "DIR [filepattern] [,W] [,P] [,R] [,D drive] [,U unit]",
      "description": "Prints a file directory/catalog of the specified disk.",
      "parameters": [
        {
          "name": "filepattern",
          "type": "string"
        },
        {
          "name": "W",
          "description": "Wide, prints in 3 columns",
          "optional": true
        },
        {
          "name": "P",
          "description": "Pagination, pauses after every screen",
          "optional": true
        },
        {
          "name": "R",
          "description": "Include files flagged as recoverable",
          "optional": true
        },
        {
          "name": "drive",
