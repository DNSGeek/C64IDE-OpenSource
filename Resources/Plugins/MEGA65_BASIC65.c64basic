        },
        {
          "name": "mc2",
          "type": "integer",
          "description": "The second multicolor value"
        }
      ]
    },
    {
      "keyword": "SPRITE",
      "prefix": 254,
      "token": 7,
      "type": "command",
      "category": "graphics",
      "syntax": "SPRITE n, enable, color, priority, multicolor, xexpand, yexpand",
      "description": "Configure a hardware sprite",
      "parameters": [
        {
          "name": "n",
          "type": "integer",
          "range": "0-7"
        },
        {
          "name": "enable",
          "type": "integer",
          "range": "0-1"
        },
        {
          "name": "color",
          "type": "integer",
          "range": "0-15"
        },
        {
          "name": "priority",
          "type": "integer",
          "range": "0-1",
          "description": "0=in front, 1=behind background"
        },
        {
          "name": "multicolor",
          "type": "integer",
          "range": "0-1",
          "optional": true
        },
        {
          "name": "xexpand",
          "type": "integer",
          "range": "0-1",
          "optional": true
        },
        {
          "name": "yexpand",
          "type": "integer",
          "range": "0-1",
          "optional": true
        }
      ],
      "example": "SPRITE 0,1,1,0\nSPRITE CLR\nSPRITE LOAD filename\nSPRITE SAVE filename\nSPRITE SYS R hires-mode"
    },
    {
      "keyword": "SPRSAV",
      "prefix": 254,
      "token": 22,
      "type": "command",
      "category": "system",
      "syntax": "SPRSAV source, destination",
