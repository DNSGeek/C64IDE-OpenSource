      "example": "LOAD \"MYPROG\",8",
      "token": 147
    },
    {
      "keyword": "SAVE",
      "type": "command",
      "category": "io",
      "syntax": "SAVE \"filename\"[, devnum]",
      "description": "Saves a file to the default device. Filename must be 12 characters or less. If filename is not specified, the last specified filename is used.",
      "example": "SAVE \"MYPROG\",8",
      "token": 148
    },
    {
      "keyword": "VERIFY",
      "type": "command",
      "category": "io",
      "syntax": "VERIFY \"filename\"[, devnum]",
