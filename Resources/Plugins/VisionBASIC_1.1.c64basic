    },
    {
      "keyword": "RENUM",
      "type": "command",
      "category": "editor",
      "syntax": "RENUM start-end, new[, step]",
      "description": "Renumbers the lines from start to end so that they begin at new.",
      "parameters": [
        {
          "name": "start-end",
          "type": "integer",
          "description": "Range of existing lines to renumber",
          "optional": false
        },
        {
          "name": "new",
          "type": "integer",
          "description": "New first line number",
          "optional": false
        },
        {
          "name": "step",
          "type": "integer",
          "description": "Line number increment; 10 if not specified",
          "optional": true
        }
      ],
      "example": "RENUM 100-500, 1000, 10",
      "prefix": 255,
      "token": 137
    },
    {
      "keyword": "RUN",
      "type": "command",
      "category": "editor",
      "syntax": "RUN [line#]",
      "description": "Runs the compiled, in-memory program. If the program is not compiled or has been altered, compiles it first. If line# is specified, starts there, otherwise from the first line.",
      "example": "RUN",
      "token": 138
    },
    {
      "keyword": "VLIST",
      "type": "command",
      "category": "editor",
      "syntax": "VLIST [num]",
      "description": "Displays all of the variables from the program in memory. If num is specified, sends the output to a printer.",
      "example": "VLIST",
      "prefix": 255,
      "token": 130
    },
    {
      "keyword": "BANK",
      "type": "command",
      "category": "memory",
      "syntax": "BANK [bank[-bank]][, on/off]",
      "description": "Displays the current bank number, or changes to the bank specified. With on/off, enables or disables the banks.",
      "parameters": [
        {
          "name": "bank",
          "type": "integer",
          "description": "Bank, or range of banks, to select or toggle",
          "optional": true
        },
        {
          "name": "on/off",
          "type": "integer",
          "range": "0-1",
          "description": "1 enables the banks, 0 disables them",
          "optional": true
        }
      ],
      "example": "BANK 2",
      "notes": "In a text video context BANK also selects the active 16K VIC-II memory bank; that is not for setting REU banks, and you will probably never need it.",
      "prefix": 252,
      "token": 128
    },
    {
      "keyword": "DEVICE",
      "type": "command",
      "category": "io",
      "syntax": "DEVICE devnum",
      "description": "Sets the device number for the default device.",
      "example": "DEVICE 9",
      "prefix": 252,
      "token": 165
    },
    {
      "keyword": "DIR",
      "type": "command",
      "category": "io",
      "syntax": "DIR [num]",
      "description": "Lists the current device's directory. If num is supplied, the listing is sent to a printer.",
      "example": "DIR",
      "prefix": 255,
      "token": 134
    },
    {
      "keyword": "DISK",
      "type": "command",
      "category": "io",
      "syntax": "DISK [\"command\"[, devnum]]",
      "description": "Equivalent to OPEN 15,devnum,15,\"command\":CLOSE 15. Uses the default device if not specified, and initializes the device if command is not specified.",
      "example": "DISK \"S0:OLDFILE\"",
      "token": 225
    },
    {
      "keyword": "GSAVE",
      "type": "command",
      "category": "io",
      "syntax": "GSAVE on",
      "description": "Saves a copy of the C64 RAM to GeoRAM expanded memory. If on is 1, enables the back-up feature.",
      "example": "GSAVE 1",
      "prefix": 255,
      "token": 144
    },
    {
      "keyword": "LOAD",
      "type": "command",
      "category": "io",
      "syntax": "LOAD \"filename\"[, devnum]",
