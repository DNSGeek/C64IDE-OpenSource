{
  "name": "VisionBASIC 1.1",
  "version": "1.1",
  "author": "peepo",
  "description": "VisionBASIC 1.1 enhanced BASIC for the Commodore 64. Adds graphics, sound, sprite, interrupt, and inline assembly commands.",
  "url": "https://www.visionbasic.net",
  "tokenBase": 203,
  "extendsBasicV2": true,
  "activationSYS": 2368,
  "assemblerMnemonics": [
    "ADC",
    "AND",
    "ASL",
    "BCC",
    "BCS",
    "BEQ",
    "BIT",
    "BMI",
    "BNE",
    "BPL",
    "BRK",
