{
  "name": "VisionBASIC 1.1",
  "version": "1.1",
  "author": "peepo",
  "description": "Vision BASIC 1.1, the compiled BASIC for the Commodore 64 by Dennis Osborn. Adds banked program editing, an integrated 6502 assembler, bitmap and sprite graphics, SID sound, raster interrupts, named subroutines, and REU/GeoRAM/SuperCPU memory commands. Token values extracted from the table at $AC31 in VISION BASIC.VEX; keyword documentation from the Vision BASIC Cheat Sheet.",
  "url": "https://www.visionbasic.net",
  "tokenBase": 203,
  "extendsBasicV2": true,
  "activationSYS": 2368,
  "assemblerMnemonics": [
    "ADC",
    "AND",
    "ASL",
    "BCC",
    "BCS",
    "BEQ",
    "BIT",
    "BMI",
    "BNE",
    "BPL",
    "BRK",
    "BVC",
    "BVS",
    "CLC",
    "CLD",
    "CLI",
    "CLV",
    "CMP",
    "CPX",
    "CPY",
    "DEC",
    "DEX",
    "DEY",
    "EOR",
    "INC",
    "INX",
    "INY",
    "JMP",
    "JSR",
    "LDA",
    "LDX",
    "LDY",
    "LSR",
    "NOP",
    "ORA",
    "PHA",
    "PHP",
    "PLA",
    "PLP",
    "ROL",
    "ROR",
    "RTI",
    "RTS",
    "SBC",
    "SEC",
    "SED",
    "SEI",
    "STA",
    "STX",
    "STY",
    "TAX",
    "TAY",
    "TSX",
    "TXA",
    "TXS",
    "TYA"
  ],
  "compositeKeywords": [
    {
      "keyword": "LONGPEEK",
      "tokens": [
        "LONG",
        "PEEK"
      ],
      "description": "Peek a byte from SuperCPU extended memory"
    },
    {
      "keyword": "LONGPOKE",
      "tokens": [
        "LONG",
        "POKE"
      ],
      "description": "Poke bytes into SuperCPU extended memory"
    },
    {
      "keyword": "REUPEEK",
      "tokens": [
        "REU",
        "PEEK"
      ],
      "description": "Peek a byte from REU memory"
    },
    {
      "keyword": "REUPOKE",
      "tokens": [
        "REU",
        "POKE"
      ],
      "description": "Poke bytes into REU memory"
    },
    {
      "keyword": "HALTINT",
      "tokens": [
        "HALT",
        "INT"
      ],
      "description": "Stop interrupt processing"
    },
    {
      "keyword": "STARTINT",
      "tokens": [
        "START",
        "INT"
      ],
      "description": "Begin an interrupt routine"
    },
    {
      "keyword": "INTEND",
      "tokens": [
        "INT",
        "END"
      ],
      "description": "End an interrupt routine"
    },
    {
      "keyword": "BMPCLR",
      "tokens": [
        "BMP",
        "CLR"
      ],
      "description": "Clear the bitmap and/or color screen"
    },
    {
      "keyword": "BMPLOC",
      "tokens": [
        "BMP",
        "LOC"
      ],
      "description": "Set the visible and draw-to bitmap screens"
    },
    {
      "keyword": "MOBCLR",
      "tokens": [
        "MOB",
        "CLR"
      ],
      "description": "Clear all sprite registers"
    },
    {
      "keyword": "MOBEXP",
      "tokens": [
        "MOB",
        "EXP"
      ],
      "description": "Set sprite X/Y expansion"
    },
    {
      "keyword": "MODULE END",
      "tokens": [
        "MODULE",
        "END"
      ],
      "description": "End of a module section"
    },
    {
      "keyword": "POINT TAG",
      "tokens": [
        "POINT",
        "TAG"
      ],
      "description": "Point a tag at the compiled address of a line"
    }
  ],
  "keywords": [
    {
      "keyword": "ASSEM",
      "type": "command",
      "category": "assembly",
      "syntax": "ASSEM",
      "description": "Switches into assembler mode. Following lines are assembled as 6502 machine language until BASIC switches back.",
      "example": "ASSEM",
      "notes": "In ML mode, mnemonics are enclosed in [] brackets and a semicolon (;) starts a comment, e.g. 100 [LDA1: ORA #1: STA1] ; TURN BASIC ROM ON. Branches and jumps take a line number directly, e.g. JMP1000.",
      "prefix": 255,
      "token": 135
    },
    {
      "keyword": "BASIC",
      "type": "command",
      "category": "assembly",
      "syntax": "BASIC",
      "description": "Switches out of assembler mode and back into BASIC.",
      "example": "BASIC",
      "prefix": 255,
      "token": 136
    },
    {
      "keyword": "COMP",
      "type": "command",
      "category": "editor",
      "syntax": "COMP [\"filename\"[, devnum]]",
      "description": "Compiles the program in memory and optionally saves the result to a file.",
      "parameters": [
        {
          "name": "filename",
          "type": "string",
          "description": "Output file name, 12 characters or less",
          "optional": true
        },
        {
          "name": "devnum",
          "type": "integer",
          "description": "Device to save to; the default device if omitted",
          "optional": true
        }
      ],
      "example": "COMP \"MYPROG\",8",
      "prefix": 255,
      "token": 131
    },
    {
      "keyword": "DELETE",
      "type": "command",
      "category": "editor",
      "syntax": "DELETE [start-end]",
      "description": "Deletes the range of lines from start to end. With no parameters, acts like NEW.",
      "example": "DELETE 100-200",
      "prefix": 255,
      "token": 138
    },
    {
      "keyword": "DESC",
      "type": "command",
      "category": "editor",
      "syntax": "DESC line#, label",
      "description": "Creates a subroutine label and starts its code at line#.",
      "example": "DESC 1000, DRAWSCREEN",
      "prefix": 255,
      "token": 132
    },
    {
      "keyword": "ERROR",
      "type": "command",
      "category": "editor",
      "syntax": "ERROR",
      "description": "Displays the errors.",
      "token": 204
    },
    {
      "keyword": "EXEC",
      "type": "command",
      "category": "editor",
      "syntax": "EXEC command block",
      "description": "Runs a single line in immediate mode. Shorthand: >",
      "example": "> PRINT \"HELLO\"",
      "notes": "The > character is an accepted shorthand for EXEC.",
      "prefix": 255,
      "token": 140
    },
    {
      "keyword": "FAST",
      "type": "command",
      "category": "system",
      "syntax": "FAST",
      "description": "Enables speed up of some commands.",
      "token": 210
    },
    {
      "keyword": "SLOW",
      "type": "command",
      "category": "system",
      "syntax": "SLOW",
      "description": "Runs at normal C64 speeds.",
      "token": 211
    },
    {
      "keyword": "FIND",
      "type": "command",
      "category": "editor",
      "syntax": "FIND text",
      "description": "Searches the program in the current bank for lines containing text.",
      "example": "FIND [LDA",
      "notes": "Do not use quotes when searching for keywords. When searching for assembly, put a left bracket in front of the instruction.",
      "prefix": 255,
      "token": 142
    },
    {
      "keyword": "LITE",
      "type": "command",
      "category": "editor",
      "syntax": "LITE [0/1]",
      "description": "With no parameter or a 1, enables LITE mode. 0 disables it.",
      "example": "LITE 1",
      "prefix": 255,
      "token": 143
    },
    {
      "keyword": "LIST",
      "type": "command",
      "category": "editor",
      "syntax": "LIST [line#[-line#]]",
      "description": "Displays the program in memory. Can optionally display only the lines between the given parameters.",
      "example": "LIST 100-200",
      "token": 155
    },
    {
      "keyword": "LISTER",
      "type": "command",
      "category": "editor",
      "syntax": "LISTER [line#]",
      "description": "A scrollable LIST. If line# is specified, starts at that line.",
      "example": "LISTER 500",
      "prefix": 255,
      "token": 133
    },
    {
      "keyword": "LLIST",
      "type": "command",
      "category": "editor",
      "syntax": "LLIST [line#[-line#[, printer?]]]",
      "description": "Displays extended details about the program in memory.",
      "parameters": [
        {
          "name": "line#",
          "type": "integer",
          "description": "First line, and optionally last line, to describe",
          "optional": true
        },
        {
          "name": "printer?",
          "type": "integer",
          "range": "0-1",
          "description": "1 sends the output to a printer",
          "optional": true
        }
      ],
      "example": "LLIST 100-200,1",
      "prefix": 255,
      "token": 141
    },
    {
      "keyword": "NEW",
      "type": "command",
      "category": "editor",
      "syntax": "NEW [bank[-bank]]",
      "description": "Clears the current program bank, or the banks specified.",
      "example": "NEW 1-3",
      "token": 162
    },
    {
      "keyword": "OLD",
      "type": "command",
      "category": "editor",
      "syntax": "OLD [bank[-bank]]",
      "description": "Attempts to restore the program in the current bank, or the banks specified.",
      "example": "OLD",
      "prefix": 255,
      "token": 128
    },
    {
      "keyword": "PLIST",
      "type": "command",
      "category": "editor",
      "syntax": "PLIST [line#[-line#]]",
