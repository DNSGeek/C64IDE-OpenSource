    {
      "keyword": "CLR",
      "type": "command",
      "category": "variables",
      "syntax": "CLR",
      "description": "Clears the memory used by all variables.",
      "token": 156
    },
    {
      "keyword": "DECIMAL",
      "type": "command",
      "category": "variables",
      "syntax": "DECIMAL variable[, variable[, variable[, ...]]]",
      "description": "Creates new decimal variables.",
      "example": "DECIMAL X, Y, RATE",
      "notes": "Variables must start with a letter and can be up to 8 characters long; anything past 8 characters is silently ignored. The symbols !, @, #, %, & and ? and numbers are allowed. Variable names can contain keywords but cannot start with one. Strings must be terminated with a dollar ($) sign. All variables are integers by default.",
      "token": 215
    },
    {
      "keyword": "DIM",
      "type": "command",
      "category": "variables",
      "syntax": "DIM [DECIMAL] variable(value)",
      "description": "Creates array variable of value size. DECIMAL makes it an array of decimals rather than integers.",
      "example": "DIM SCORES(20)",
      "token": 134
    },
    {
      "keyword": "DEF",
      "type": "command",
      "category": "variables",
      "syntax": "DEF type var[, var, var, ...]",
      "description": "Defines variable types in a structured fashion.",
      "parameters": [
        {
          "name": "type",
          "type": "keyword",
          "range": "TAG | LABEL | INT | INTEGER | DECIMAL",
          "description": "The type to give the listed variables",
